# Lokálně není nutné nic nastavovat (výchozí: localhost, base "/", noindex).
# V GitHub Actions se hodnoty berou z proměnných repozitáře (Settings → Secrets and variables → Actions → Variables).

# Veřejná adresa webu bez koncového lomítka
SITE_URL=https://lukaspilko1-sketch.github.io
# Podsložka webu: "/idetone" pro testovací github.io, "/" pro idetone.cz
BASE_PATH=/idetone
# Indexace vyhledávači: false = noindex + robots.txt Disallow (testovací provoz)
PUBLIC_INDEXING=false
