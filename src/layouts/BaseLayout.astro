---
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { features, indexing } from '../config/site';
import { cs } from '../i18n/cs';
import { url } from '../utils/url';
import { getSettings } from '../utils/content';
import { breadcrumbs, organization, type Crumb } from '../utils/seo';

interface Props {
  title: string;
  description: string;
  /** vynutí noindex i při zapnuté indexaci (např. styleguide, děkovací stránka) */
  noindex?: boolean;
  /** OG obrázek – cesta bez base, např. „/og/sara.png“ (generuje npm run og) */
  image?: string;
  imageAlt?: string;
  ogType?: 'website' | 'product' | 'article';
  /** drobečková navigace pro JSON-LD (bez Úvodu) */
  crumbs?: Crumb[];
  /** další JSON-LD objekty (Product, LocalBusiness…) */
  jsonLd?: object[];
}

const {
  title,
  description,
  noindex = false,
  image = '/og/default.png',
  imageAlt = 'ideTone – reprosoustavy s citem pro hudbu',
  ogType = 'website',
  crumbs,
  jsonLd = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url(image), Astro.site);
const robots = !indexing || noindex;
const settings = await getSettings();

const schema = [
  organization(settings, Astro.site),
  ...(crumbs?.length ? [breadcrumbs(crumbs, Astro.site)] : []),
  ...jsonLd,
];

// hreflang – aktivní až se zapnutou angličtinou (features.english)
const path = Astro.url.pathname.slice(import.meta.env.BASE_URL.replace(/\/$/, '').length) || '/';
const csPath = path.replace(/^\/en\//, '/');
const alternates = features.english
  ? [
      { lang: 'cs', href: new URL(url(csPath), Astro.site) },
      { lang: 'en', href: new URL(url(`/en${csPath}`), Astro.site) },
    ]
  : [];
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {robots && <meta name="robots" content="noindex, nofollow" />}
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.lang} href={a.href} />
    ))}
    {alternates.length > 0 && (
      <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    )}

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="ideTone" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <meta name="theme-color" content="#E9E6DF" />

    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />

    <!-- Písma: preload jen hlavního textového řezu (latin + latin-ext kvůli češtině) -->
    <Font cssVariable="--font-text" preload={[{ weight: 400 }]} />
    <Font cssVariable="--font-heading" />
    <Font cssVariable="--font-mono" />

    <!-- Místo pro budoucí analytiku bez cookies (Plausible / Umami) -->
  </head>
  <body>
    <a class="skip-link" href="#obsah">
      {cs.skipLink}
    </a>
    <Header />
    <main id="obsah" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script>
      // Jemné odkrytí sekcí při scrollu (jednou). Bez JS nebo s omezeným pohybem je vše vidět hned.
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-revealed'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }

  :global(html.is-locked) {
    overflow: hidden;
  }
</style>
