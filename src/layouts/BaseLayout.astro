---
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { indexing } from '../config/site';
import { cs } from '../i18n/cs';
import { url } from '../utils/url';

interface Props {
  title: string;
  description?: string;
  /** vynutí noindex i při zapnuté indexaci (např. styleguide, admin) */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {(!indexing || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#E9E6DF" />

    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />

    <!-- Písma: preload jen hlavního textového řezu (latin + latin-ext kvůli češtině) -->
    <Font cssVariable="--font-text" preload={[{ weight: 400 }]} />
    <Font cssVariable="--font-heading" />
    <Font cssVariable="--font-mono" />

    <!-- Místo pro budoucí analytiku bez cookies (Plausible / Umami) -->
  </head>
  <body>
    <a class="skip-link" href="#obsah">
      {cs.skipLink}
    </a>
    <Header />
    <main id="obsah" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script>
      // Jemné odkrytí sekcí při scrollu (jednou). Bez JS nebo s omezeným pohybem je vše vidět hned.
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-revealed'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }

  :global(html.is-locked) {
    overflow: hidden;
  }
</style>
