---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactForm from '../components/ContactForm.astro';
import Photo from '../components/Photo.astro';
import { getPage, getSettings } from '../utils/content';
import { typo } from '../utils/format';

const { data } = await getPage('zakazkove-projekty');
const settings = await getSettings();
---

<BaseLayout
  title={`${data.seoTitle ?? data.title} | ideTone`}
  description={data.description}
  crumbs={[{ name: 'Zakázkové projekty', href: '/zakazkove-projekty/' }]}
>
  <PageHeader eyebrow={data.eyebrow} title={data.title} lead={data.lead} />

  {data.photos[0] && (
    <Section space="none" reveal={false}>
      <div class="intro-photo">
        <Photo
          src={data.photos[0].src}
          alt={data.photos[0].alt}
          placeholder={data.photos[0].placeholder}
          ratio="16/9"
          sizes="(min-width: 75rem) 1200px, 100vw"
        />
      </div>
    </Section>
  )}

  <Section divider labelledby="postup-title">
    <h2 id="postup-title" class="title">
      Postup spolupráce
    </h2>
    <ol role="list" class="steps">
      {data.steps.map((step, i) => (
        <li class="step">
          <span class="step__num mono" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3>{typo(step.title)}</h3>
          <p>{typo(step.text)}</p>
        </li>
      ))}
    </ol>
  </Section>

  <Section divider>
    <div class="form-row">
      <div class="form-wrap">
        <ContactForm
          type="custom"
          id="poptavka"
          title="Nezávazná poptávka"
          email={settings.contact.email}
        />
      </div>
      {data.photos[1] && (
        <Photo
          src={data.photos[1].src}
          alt={data.photos[1].alt}
          placeholder={data.photos[1].placeholder}
          ratio="1/1"
          sizes="(min-width: 64rem) 360px, 100vw"
          class="form-row__photo"
        />
      )}
    </div>
  </Section>
</BaseLayout>

<style>
  .title {
    margin-bottom: var(--space-7);
  }

  .steps {
    display: grid;
    gap: var(--space-7) var(--grid-gap);
    counter-reset: step;
  }

  .step {
    max-width: none;
    padding-top: var(--space-4);
    border-top: 1px solid var(--c-grafit);
  }

  .step__num {
    display: block;
    margin-bottom: var(--space-5);
    font-size: var(--fs-l);
    color: var(--c-dub-text);
  }

  .step h3 {
    font-size: var(--fs-m);
  }

  .step p {
    margin-top: var(--space-3);
  }

  @media (min-width: 48rem) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 72rem) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .intro-photo {
    padding-bottom: var(--section-space);
  }

  .form-row {
    display: grid;
    gap: var(--space-7) var(--grid-gap);
    align-items: start;
  }

  .form-row :global(.form-row__photo) {
    max-width: 24rem;
  }

  @media (min-width: 64rem) {
    .form-row {
      grid-template-columns: 8fr 4fr;
    }

    .form-row :global(.form-row__photo) {
      position: sticky;
      top: calc(var(--header-scrolled-h) + var(--space-6));
    }
  }

  .form-wrap {
    max-width: 48rem;
  }
</style>
