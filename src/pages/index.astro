---
/**
 * Úvodní stránka – sekce a jejich pořadí se berou ze src/content/home.yaml.
 */
import { Picture } from 'astro:assets';
import { getEntry, getEntries } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import ProductFeature from '../components/ProductFeature.astro';
import Quote from '../components/Quote.astro';
import Photo from '../components/Photo.astro';
import HeroMedia from '../components/HeroMedia.astro';
import { features } from '../config/site';
import { getHome, getSettings } from '../utils/content';
import { formatPrice, typo } from '../utils/format';
import { url } from '../utils/url';
import { localBusiness } from '../utils/seo';

// NÁVRH: ke schválení (meta popis úvodní stránky níže)
const { showPrices, sections } = await getHome();
const settings = await getSettings();

// Načtení produktů, na které sekce odkazují
const resolved = await Promise.all(
  sections.map(async (section) => {
    if (section.type === 'hero') {
      return { section, product: await getEntry(section.product) };
    }
    if (section.type === 'models') {
      return { section, products: await getEntries(section.products) };
    }
    return { section };
  }),
);
---

<BaseLayout
  title="ideTone – reprosoustavy s citem pro hudbu"
  description="Ručně laděné dvoupásmové reprosoustavy Sara a Reva od Petra Kocourka z Brna. Poslech ve studiu v Brně, objednávka a zakázkové projekty."
  jsonLd={[localBusiness(settings, Astro.site)]}
>
  {
    resolved.map((item) => {
      const s = item.section;

      if (s.type === 'hero' && 'product' in item && item.product) {
        const p = item.product;
        const bg = s.background;
        return (
          <section class="hero" aria-labelledby="hero-title" data-hero>
            <div class="container hero__grid">
              <div class="hero__text">
                <span class="eyebrow hero__in" style="--i: 0">
                  {s.eyebrow}
                </span>
                <h1 id="hero-title" class="hero__in" style="--i: 1">
                  {typo(s.title)}
                </h1>
                <p class="lead hero__lead hero__in" style="--i: 2">
                  {typo(s.text)}
                </p>
                <div class="hero__actions hero__in" style="--i: 3">
                  <Button href={s.primary.href}>{s.primary.label}</Button>
                  {s.secondary && (
                    <Button href={s.secondary.href} variant="secondary">
                      {s.secondary.label}
                    </Button>
                  )}
                </div>
              </div>
              <figure class="hero__visual">
                {/* Pozadí za sklem: na mobilu pod textem, na desktopu pravá část hero */}
                <HeroMedia
                  image={bg?.image.src ?? s.image.src}
                  video={bg?.video}
                  videoMp4={bg?.videoMp4}
                  position="35% 50%"
                  class="hero__bg"
                />
                <figcaption class="hero__caption mono">
                  <a href={url(`/reprosoustavy/${p.id}/`)}>{p.data.name}</a>
                  <span>
                    {showPrices ? `${formatPrice(p.data.price)} / pár` : p.data.type}
                  </span>
                </figcaption>
                <div class="hero__product" data-parallax>
                  <Picture
                    src={s.image.src}
                    alt={s.image.alt}
                    formats={['avif', 'webp']}
                    fallbackFormat="webp"
                    widths={[360, 560, 800]}
                    sizes="(min-width: 64rem) 400px, 70vw"
                    loading="eager"
                    fetchpriority="high"
                    class="hero__img"
                  />
                </div>
              </figure>
            </div>
          </section>
        );
      }

      if (s.type === 'models' && 'products' in item && item.products) {
        return (
          <Section id="modely" labelledby="modely-title" reveal={false} class="models">
            <header class="models__head" data-reveal>
              {s.eyebrow && <span class="eyebrow">{s.eyebrow}</span>}
              <h2 id="modely-title">{typo(s.title)}</h2>
            </header>
            <div class="models__list">
              {item.products.map((product, i) => (
                <div class:list={['models__item', i % 2 === 0 ? 'models__item--a' : 'models__item--b']}>
                  <ProductFeature
                    product={product}
                    variant={i % 2 === 0 ? 'tall' : 'compact'}
                    showPrice={showPrices}
                  />
                </div>
              ))}
            </div>
            {s.compareLink && (
              <p class="models__compare" data-reveal>
                <Button href={s.compareLink.href} variant="secondary">
                  {s.compareLink.label}
                </Button>
              </p>
            )}
          </Section>
        );
      }

      if (s.type === 'quote') {
        return (
          <Section divider class="quote-section">
            <div class:list={['quote-row', { 'quote-row--image': s.image }]}>
              <Quote text={s.text} author={s.author} link={s.link} />
              {s.image && (
                <Photo
                  src={s.image.src}
                  alt={s.image.alt}
                  placeholder={s.image.placeholder}
                  ratio="4/5"
                  sizes="(min-width: 64rem) 360px, 80vw"
                  class="quote-row__img"
                />
              )}
            </div>
          </Section>
        );
      }

      if (s.type === 'technology') {
        return (
          <Section divider labelledby="technologie-title" reveal={false}>
            <div class="tech">
              {s.image && (
                <Photo
                  src={s.image.src}
                  alt={s.image.alt}
                  placeholder={s.image.placeholder}
                  ratio="4/5"
                  position="60% 50%"
                  sizes="(min-width: 64rem) 420px, 100vw"
                  class="tech__photo"
                />
              )}
              <div class="tech__content">
                <header class="tech__head" data-reveal>
                  {s.eyebrow && <span class="eyebrow">{s.eyebrow}</span>}
                  <h2 id="technologie-title">{typo(s.title)}</h2>
                </header>
                <ul role="list" class="tech__cols" data-reveal>
                  {s.items.map((t) => (
                    <li class="tech__col">
                      <h3>{typo(t.title)}</h3>
                      <p>{typo(t.text)}</p>
                      {t.href && (
                        <a class="tech__link" href={url(t.href)}>
                          Víc o řešení <span aria-hidden="true">→</span>
                          <span class="visually-hidden">: {t.title}</span>
                        </a>
                      )}
                    </li>
                  ))}
                </ul>
                {s.link && (
                  <p class="tech__more" data-reveal>
                    <Button href={s.link.href} variant="secondary">
                      {s.link.label}
                    </Button>
                  </p>
                )}
              </div>
            </div>
          </Section>
        );
      }

      if (s.type === 'listening') {
        return (
          <Section
            tone="uhel"
            labelledby="poslech-title"
            space="m"
            glass="30% 60%"
            glassImage={s.background?.src}
          >
            <div class="listen">
              <div>
                {s.eyebrow && <span class="eyebrow">{s.eyebrow}</span>}
                <h2 id="poslech-title" class="listen__title">
                  {typo(s.title)}
                </h2>
                {s.text && <p class="listen__text">{typo(s.text)}</p>}
              </div>
              <div class="listen__side">
                <address class="mono">
                  {settings.studio.street}
                  <br />
                  {settings.studio.city}
                </address>
                {settings.studio.parking && <p class="small">{typo(settings.studio.parking)}</p>}
                <Button href={s.button.href} tone="dark">
                  {s.button.label}
                </Button>
              </div>
            </div>
          </Section>
        );
      }

      // Reference: zobrazí se až se zapnutým flagem a skutečnými citacemi
      if (s.type === 'references' && features.references) {
        return null;
      }

      return null;
    })
  }
</BaseLayout>

<script>
  import { onPage } from '../utils/lifecycle';

  // Parallax produktu v hero: pomalejší posun než text (jen desktop, bez omezení pohybu)
  onPage((signal) => {
    const product = document.querySelector<HTMLElement>('[data-parallax]');
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    if (!product || !hero) return;
    const motion = window.matchMedia('(prefers-reduced-motion: no-preference) and (min-width: 64rem)');
    let ticking = false;
    const update = () => {
      ticking = false;
      if (!motion.matches) {
        product.style.removeProperty('--parallax');
        return;
      }
      const y = Math.min(window.scrollY, hero.offsetHeight);
      product.style.setProperty('--parallax', `${(y * -0.12).toFixed(1)}px`);
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true, signal },
    );
    update();
  });
</script>

<style>
  /* Hero */
  .hero {
    position: relative;
    z-index: 1;
    padding-top: clamp(var(--space-6), 4vw, var(--space-7));
  }

  .hero__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--grid-gap);
  }

  .hero__text {
    grid-column: 1 / -1;
    padding-bottom: var(--space-7);
  }

  .hero h1 {
    margin-top: var(--space-4);
    max-width: 14ch;
  }

  .hero__lead {
    margin-top: var(--space-5);
    max-width: 42ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  /* Nástup při načtení: štítek, nadpis, text, tlačítka postupně; produkt se vynoří zespodu.
     Čisté CSS – bez JS i s omezeným pohybem je vše vidět hned. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__in {
      animation: hero-in 460ms var(--ease-out) both;
      animation-delay: calc(var(--i) * var(--hero-stagger));
    }

    .hero__visual :global(.hero__img) {
      animation: hero-rise 700ms var(--ease-out) 120ms both;
    }
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
  }

  /* Mobil: tmavá plocha pod textem přes celou šířku, produkt přesahuje dolů */
  .hero__visual {
    grid-column: 1 / -1;
    position: relative;
    isolation: isolate;
    margin-inline: calc(-1 * var(--gutter));
    margin-bottom: calc(-1 * var(--space-8));
    padding: var(--space-5) var(--gutter) 0;
  }

  .hero__visual :global(.hero__bg) {
    inset: 0 0 var(--space-8);
  }

  /* Skleněný štítek s modelem */
  .hero__caption {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    background: var(--glass-card);
    border: 1px solid var(--glass-edge);
    border-radius: var(--radius);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    font-size: var(--fs-data);
    color: var(--c-on-dark); /* na skleněné kartě plná barva kvůli kontrastu */
  }

  .hero__caption a {
    color: var(--c-on-dark);
    font-weight: 500;
    text-decoration: none;
  }

  .hero__caption a:hover {
    color: var(--c-dub-light);
  }

  .hero__product {
    transform: translate3d(0, var(--parallax, 0), 0);
    will-change: transform;
  }

  .hero__visual :global(.hero__img) {
    width: min(78%, 22rem);
    height: auto;
    margin: var(--space-5) auto 0;
    filter: drop-shadow(0 24px 30px rgb(0 0 0 / 0.28));
  }

  @media (min-width: 64rem) {
    .hero__text {
      grid-column: 1 / span 6;
      align-self: center;
      padding-bottom: var(--space-10);
    }

    /* Na desktopu je pozadí pravá část celé hero sekce */
    .hero__visual {
      position: static;
      grid-column: 8 / span 5;
      margin: 0 0 calc(-1 * var(--space-9));
      padding: var(--space-6) 0 0;
      align-self: end;
    }

    .hero__visual :global(.hero__bg) {
      inset: 0 0 0 58%;
    }

    .hero__visual :global(.hero__img) {
      width: min(100%, 25rem);
    }
  }

  /* Modely – zhuštěné, dva odlišné bloky vedle sebe */
  .models {
    padding-top: calc(var(--section-space) + var(--space-8));
  }

  .models__head {
    margin-bottom: var(--space-7);
  }

  .models__head h2,
  .tech__head h2 {
    margin-top: var(--space-3);
  }

  .models__list {
    display: grid;
    gap: var(--space-8) var(--grid-gap);
  }

  .models__compare {
    margin-top: var(--space-7);
  }

  @media (min-width: 64rem) {
    .models {
      padding-top: calc(var(--section-space) + var(--space-9));
    }

    .models__list {
      grid-template-columns: 7fr 5fr;
      align-items: start;
      column-gap: var(--space-8);
    }

    /* Kompaktní Reva odsazená dolů – ne dvě stejné karty v řadě */
    .models__item--b {
      margin-top: var(--space-7);
      padding-left: var(--space-7);
      border-left: var(--border);
    }
  }

  /* Citát s fotkou */
  .quote-row {
    display: grid;
    gap: var(--space-7) var(--grid-gap);
    align-items: center;
  }

  .quote-row :global(.quote-row__img) {
    max-width: 22rem;
  }

  @media (min-width: 64rem) {
    .quote-row--image {
      grid-template-columns: 7fr 4fr;
    }

    .quote-row :global(.quote-row__img) {
      justify-self: end;
      width: 100%;
    }
  }

  /* Technologie – jedna fotka + tři sloupce */
  .tech {
    display: grid;
    gap: var(--space-7) var(--grid-gap);
  }

  .tech :global(.tech__photo) {
    max-width: 26rem;
  }

  .tech__head {
    margin-bottom: var(--space-7);
  }

  .tech__cols {
    display: grid;
    gap: var(--space-6) var(--grid-gap);
  }

  .tech__col {
    max-width: none;
    padding-top: var(--space-3);
    border-top: 1px solid var(--c-grafit);
  }

  .tech__col h3 {
    font-size: var(--fs-m);
  }

  .tech__col p {
    margin-top: var(--space-3);
  }

  .tech__link {
    display: inline-flex;
    gap: var(--space-2);
    margin-top: var(--space-3);
    font-weight: 500;
    text-decoration: none;
  }

  .tech__link span[aria-hidden] {
    transition: transform var(--dur-fast) var(--ease);
  }

  .tech__link:hover span[aria-hidden] {
    transform: translateX(4px);
  }

  .tech__more {
    margin-top: var(--space-7);
  }

  @media (min-width: 48rem) {
    .tech__cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .tech {
      grid-template-columns: 4fr 8fr;
      column-gap: var(--space-8);
      align-items: center;
    }

    .tech :global(.tech__photo) {
      max-width: none;
    }
  }

  /* Poslech */
  .listen {
    display: grid;
    gap: var(--space-7) var(--grid-gap);
    align-items: end;
  }

  .listen__title {
    margin-top: var(--space-3);
    max-width: 16ch;
  }

  .listen__text {
    margin-top: var(--space-4);
    max-width: 44ch;
    color: var(--c-on-dark-muted);
  }

  /* Skleněná karta s adresou; malý text v plné barvě (kontrast AA na skle) */
  .listen__side {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    padding: var(--space-6);
    background: var(--glass-card);
    border: 1px solid var(--glass-edge);
    border-radius: var(--radius);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
  }

  .listen__side address {
    font-style: normal;
    font-size: var(--fs-m);
    line-height: 1.4;
  }

  @media (min-width: 48rem) {
    .listen {
      grid-template-columns: 7fr 4fr;
    }
  }
</style>
