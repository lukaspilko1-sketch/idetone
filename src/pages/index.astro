---
/**
 * Úvodní stránka – sekce a jejich pořadí se berou ze src/content/home.yaml.
 */
import { Picture } from 'astro:assets';
import { getEntries, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import ProductFeature from '../components/ProductFeature.astro';
import Quote from '../components/Quote.astro';
import Photo from '../components/Photo.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import { features } from '../config/site';
import { getHome, getSettings } from '../utils/content';
import { paragraphs, typo } from '../utils/format';
import { url } from '../utils/url';
import { localBusiness } from '../utils/seo';

// NÁVRH: ke schválení (meta popis úvodní stránky níže)
const { showPrices, sections } = await getHome();
const settings = await getSettings();

// Načtení produktů, na které sekce odkazují
const resolved = await Promise.all(
  sections.map(async (section) =>
    section.type === 'models'
      ? { section, products: await getEntries(section.products) }
      : { section },
  ),
);

// Kóty v hero: rozměry z dat produktu („š 240 × v 1000 × h 383 mm“), ne natvrdo
const heroSection = sections.find((s) => s.type === 'hero');
let heroDims: { width: string; height: string } | undefined;
if (heroSection?.type === 'hero' && heroSection.decor.dimensions && heroSection.dimensionsFrom) {
  const product = await getEntry(heroSection.dimensionsFrom);
  const dims = product?.data.specs.dimensions ?? '';
  const width = dims.match(/š\s*(\d+)/)?.[1];
  const height = dims.match(/v\s*(\d+)/)?.[1];
  if (width && height) heroDims = { width, height };
}
---

<BaseLayout
  title="ideTone – reprosoustavy s citem pro hudbu"
  description="Ručně laděné dvoupásmové reprosoustavy Sara a Reva od Petra Kocourka z Brna. Poslech ve studiu v Brně, objednávka a zakázkové projekty."
  jsonLd={[localBusiness(settings, Astro.site)]}
>
  {resolved.map((item) => {
    const s = item.section;

    // Hero: text vlevo, kresba s podpisem vpravo (dávka 2.2)
    if (s.type === 'hero') {
      return (
        <section
          class:list={[
            'hero',
            {
              'hero--grain': s.decor.grain,
              'hero--light': s.decor.light,
              'hero--grid': s.decor.grid,
            },
          ]}
          aria-labelledby="hero-title"
        >
          <div class="container hero__grid">
            <div class="hero__text">
              <span class="eyebrow hero__in" style="--i: 0">
                {s.eyebrow}
              </span>
              <h1 id="hero-title" class="hero__in" style="--i: 1">
                {/* každý řádek z home.yaml = jedna věta */}
                {s.title.split(/\r?\n/).map((line) => (
                  <span class="hero__line">
                    {/* „|“ jako jemný oddělovač */}
                    {typo(line.trim())
                      .split(' | ')
                      .map((part, j) => (
                        <>
                          {j > 0 && (
                            <>
                              {/* před oddělovačem nezlomitelná mezera – řádek se láme až za ním */}
                              {' '}
                              <span class="hero__sep" aria-hidden="true">
                                |
                              </span>{' '}
                            </>
                          )}
                          <span class="hero__part">{part}</span>
                        </>
                      ))}
                  </span>
                ))}
              </h1>
              <p class="lead hero__lead hero__in" style="--i: 2">
                {typo(s.text)}
              </p>
              {s.scroll && (
                <a class="hero__scroll hero__in" style="--i: 3" href={url(s.scroll.href)}>
                  {s.scroll.label} <span aria-hidden="true">↓</span>
                </a>
              )}
            </div>
            <figure class="hero__art">
              <div class="hero__drawing-wrap">
                <Picture
                  src={s.drawing.src}
                  alt={s.drawing.alt}
                  formats={['avif', 'webp']}
                  fallbackFormat="webp"
                  widths={[s.drawing.src.width]}
                  sizes={`${s.drawing.src.width}px`}
                  loading="eager"
                  fetchpriority="high"
                  class="hero__drawing"
                />
                {/* Kóty – objeví se po dokreslení kresby */}
                {heroDims && (
                  <div class="hero__dims" aria-hidden="true">
                    <span class="dim dim--v">
                      <span class="dim__label">{heroDims.height}&nbsp;mm</span>
                    </span>
                    <span class="dim dim--h">
                      <span class="dim__label">{heroDims.width}&nbsp;mm</span>
                    </span>
                  </div>
                )}
              </div>
              {s.signature && (
                <Picture
                  src={s.signature.src}
                  alt={s.signature.alt}
                  formats={['avif', 'webp']}
                  fallbackFormat="webp"
                  widths={[s.signature.src.width]}
                  sizes={`${s.signature.src.width}px`}
                  loading="eager"
                  class="hero__signature"
                />
              )}
            </figure>
          </div>
        </section>
      );
    }

    // Modely: dva stejně široké sloupce, fotky na stejné podlaze, bez specifikací (dávka 2.4)
    if (s.type === 'models' && 'products' in item && item.products) {
      return (
        <Section id="modely" divider labelledby="modely-title" reveal={false} class="models">
          <header class="models__head" data-reveal>
            {s.eyebrow && <span class="eyebrow">{s.eyebrow}</span>}
            <h2 id="modely-title">{typo(s.title)}</h2>
          </header>
          <div class="models__list">
            {item.products.map((product) => (
              <ProductFeature
                product={product}
                variant="column"
                showPrice={showPrices}
                showSpecs={false}
              />
            ))}
          </div>
          {s.compareLink && (
            <p class="models__compare" data-reveal>
              <Button href={s.compareLink.href} variant="secondary">
                {s.compareLink.label}
              </Button>
            </p>
          )}
        </Section>
      );
    }

    // Koncept: velký výrok vlevo, texty a podpis vpravo (dávka 2.5a)
    if (s.type === 'concept') {
      return (
        <Section divider labelledby="koncept-title">
          <div class="concept">
            <div>
              {s.eyebrow && (
                <h2 id="koncept-title" class="eyebrow">
                  {s.eyebrow}
                </h2>
              )}
              <p class="concept__statement">{typo(s.statement)}</p>
            </div>
            <div class="concept__body">
              {paragraphs(s.text).map((p) => (
                <p>{typo(p)}</p>
              ))}
              <p class="concept__sign">
                {s.signature ? (
                  <Picture
                    src={s.signature.src}
                    alt={s.signature.alt}
                    formats={['avif', 'webp']}
                    fallbackFormat="webp"
                    widths={[s.signature.src.width]}
                    sizes="180px"
                    class="concept__signature"
                  />
                ) : (
                  <span>{s.author}</span>
                )}
              </p>
              {s.link && (
                <a class="arrow-link" href={url(s.link.href)}>
                  {s.link.label} <span aria-hidden="true">→</span>
                </a>
              )}
            </div>
          </div>
        </Section>
      );
    }

    // Proces vývoje: skutečný postup, tři kroky s fotkou (dávka 2.5b)
    if (s.type === 'process') {
      return (
        <Section divider labelledby="proces-title" reveal={false}>
          <header class="process__head" data-reveal>
            {s.eyebrow && <span class="eyebrow">{s.eyebrow}</span>}
            <h2 id="proces-title">{typo(s.title)}</h2>
          </header>
          <ProcessSteps steps={s.steps} />
          {s.link && (
            <p class="process__more" data-reveal>
              <a class="arrow-link" href={url(s.link.href)}>
                {s.link.label} <span aria-hidden="true">→</span>
              </a>
            </p>
          )}
        </Section>
      );
    }

    if (s.type === 'quote') {
      return (
        <Section divider class="quote-section">
          <Quote text={s.text} author={s.author} link={s.link} />
        </Section>
      );
    }

    // Technologie – jedna fotka + tři sloupce
    if (s.type === 'technology') {
      return (
        <Section divider labelledby="technologie-title" reveal={false}>
          <div class="tech">
            {s.image && (
              <Photo
                src={s.image.src}
                alt={s.image.alt}
                placeholder={s.image.placeholder}
                ratio="4/5"
                position="60% 50%"
                sizes="(min-width: 64rem) 420px, 100vw"
                class="tech__photo"
              />
            )}
            <div class="tech__content">
              <header class="tech__head" data-reveal>
                {s.eyebrow && <span class="eyebrow">{s.eyebrow}</span>}
                <h2 id="technologie-title">{typo(s.title)}</h2>
              </header>
              <ul role="list" class="tech__cols" data-reveal>
                {s.items.map((t) => (
                  <li class="tech__col">
                    <h3>{typo(t.title)}</h3>
                    <p>{typo(t.text)}</p>
                    {t.href && (
                      <a class="arrow-link" href={url(t.href)}>
                        Víc o řešení <span aria-hidden="true">→</span>
                        <span class="visually-hidden">: {t.title}</span>
                      </a>
                    )}
                  </li>
                ))}
              </ul>
              {s.link && (
                <p class="tech__more" data-reveal>
                  <Button href={s.link.href} variant="secondary">
                    {s.link.label}
                  </Button>
                </p>
              )}
            </div>
          </div>
        </Section>
      );
    }

    if (s.type === 'listening') {
      return (
        <Section tone="dub" labelledby="poslech-title" space="m">
          <div class="listen">
            <div>
              {s.eyebrow && <span class="eyebrow">{s.eyebrow}</span>}
              <h2 id="poslech-title" class="listen__title">
                {typo(s.title)}
              </h2>
              {s.text && <p class="listen__text">{typo(s.text)}</p>}
            </div>
            <div class="listen__side">
              <address class="mono">
                {settings.studio.street}
                <br />
                {settings.studio.city}
              </address>
              {settings.studio.parking && <p class="small">{typo(settings.studio.parking)}</p>}
              <Button href={s.button.href} tone="wood">
                {s.button.label}
              </Button>
            </div>
          </div>
        </Section>
      );
    }

    // Reference: zobrazí se až se zapnutým flagem a skutečnými citacemi
    if (s.type === 'references' && features.references) {
      return null;
    }

    return null;
  })}
</BaseLayout>

<style>
  /* Hero – světlé, kresba s podpisem, max. jedna obrazovka */
  .hero {
    position: relative;
    isolation: isolate;
    overflow-x: clip; /* světlo a mřížka za kresbou nesmí přetéct do strany */
    display: grid;
    align-items: center;
    min-height: min(calc(100svh - var(--header-top-h)), 52rem);
    padding-block: var(--space-6) var(--space-7);
  }

  /* Pozadí hero (dávka 3.4): zrnitost papíru – jen v hero, vypínatelné v home.yaml */
  .hero--grain::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: var(--paper-grain);
    background-size: 220px 220px;
    mix-blend-mode: multiply;
    opacity: var(--paper-grain-opacity);
    pointer-events: none;
  }

  .hero__grid {
    display: grid;
    gap: var(--space-6) var(--grid-gap);
    align-items: center;
  }

  .hero h1 {
    margin-top: var(--space-4);
  }

  .hero__line {
    display: block;
  }

  /* Další řádky nadpisu („Emoce i klid. Na celý život.“) o něco menší než hlavní věta */
  /* Druhý řádek („Emoce | Klid | Hodiny poslechu bez únavy“): menší, v dubu, s větší mezerou */
  .hero__line + .hero__line {
    margin-top: var(--space-4);
    font-size: 0.56em;
    letter-spacing: 0;
    color: var(--c-dub-text);
  }

  /* část věty se nezalomí uvnitř, řádek se láme jen u oddělovače */
  .hero__line + .hero__line .hero__part {
    white-space: nowrap;
  }

  .hero__sep {
    margin-inline: 0.2em;
    color: var(--c-dub);
    font-weight: 400;
  }

  .hero__lead {
    margin-top: var(--space-5);
    max-width: 40ch;
  }

  /* Výzva ke scrollu – strojopis, ne tlačítko */
  .hero__scroll {
    display: inline-flex;
    gap: var(--space-2);
    margin-top: var(--space-6);
    padding-block: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--fs-data);
    color: var(--c-muted);
    text-decoration: none;
  }

  .hero__scroll:hover {
    color: var(--c-grafit);
  }

  .hero__art {
    position: relative;
    isolation: isolate;
    display: grid;
    justify-items: center;
    container-type: inline-size;
  }

  /* Teplé světlo za kresbou */
  .hero--light .hero__art::before {
    content: '';
    position: absolute;
    inset: -12% -18%;
    z-index: -2;
    background: radial-gradient(closest-side, var(--c-light-warm), transparent);
    pointer-events: none;
  }

  /* Jemná mřížka (technický výkres) v oválu za kresbou */
  .hero--grid .hero__art::after {
    content: '';
    position: absolute;
    inset: -6% -14%;
    z-index: -1;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 32px 32px;
    background-position: center;
    mask-image: radial-gradient(closest-side, #000 35%, transparent 100%);
    pointer-events: none;
  }

  .hero__drawing-wrap {
    position: relative;
    width: fit-content;
    margin-inline: auto;
  }

  /* Kóty se skutečnými rozměry (z dat produktu) */
  .hero__dims {
    position: absolute;
    inset: 0;
    pointer-events: none;
    color: var(--c-dub-text);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
  }

  .dim {
    position: absolute;
    display: grid;
    place-items: center;
  }

  /* svislá kóta vlevo od kresby: výška */
  .dim--v {
    top: 1%;
    bottom: 4%;
    left: -1.75rem;
    width: 1rem;
    border-block: 1px solid currentColor;
  }

  .dim--v::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 50%;
    border-left: 1px solid currentColor;
  }

  .dim--v .dim__label {
    position: relative;
    padding-block: var(--space-2);
    background: var(--c-len);
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  /* vodorovná kóta nad levou reprosoustavou: šířka */
  .dim--h {
    top: -1.75rem;
    left: 3%;
    width: 37%;
    height: 1rem;
    border-inline: 1px solid currentColor;
  }

  .dim--h::before {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    border-top: 1px solid currentColor;
  }

  .dim--h .dim__label {
    position: relative;
    padding-inline: var(--space-2);
    background: var(--c-len);
  }

  @media (max-width: 47.99rem) {
    .hero__dims {
      font-size: 0.6875rem;
    }

    .dim--v {
      left: -1.25rem;
    }
  }

  .hero__art :global(.hero__drawing) {
    width: auto;
    height: var(--hero-art-h);
    max-width: 100%;
    object-fit: contain;
  }

  /* Podpis menší, mírně vpravo – autorský podpis pod kresbou */
  .hero__art :global(.hero__signature) {
    justify-self: end;
    width: min(55%, 11rem);
    height: auto;
    margin-top: var(--space-2);
    margin-right: 6%;
  }

  /* Desktop: hero přes celou výšku pod hlavičkou, větší nadpis i kresba, menší mezery */
  @media (min-width: 64rem) {
    .hero {
      min-height: calc(100svh - var(--header-top-h));
      padding-block: var(--space-5);
    }

    /* Levá část (nadpis) širší, kresba užší */
    .hero__grid {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      column-gap: var(--space-7);
    }

    /* Text svisle na střed vůči kresbě (dávka 3.2) */
    .hero__text {
      align-self: center;
      container-type: inline-size;
    }

    /* Nadpis co největší (max. --fs-hero), ale věta se nezalomí:
       nejdelší řádek má cca 14 em, proto max. 7 % šířky sloupce na písmeno */
    .hero h1 {
      margin-top: var(--space-3);
      font-size: min(var(--fs-hero), 7cqi);
      line-height: 1.1;
    }

    .hero__line {
      white-space: nowrap;
    }

    .hero__lead {
      max-width: 36ch;
    }

    /* Kresba vyplní užší pravý sloupec, výšku hlídá --hero-art-h */
    .hero__art {
      justify-items: center;
    }

    /* výška podle obrazovky, ale nepřeteče šířku sloupce (kresba 378 × 561 → 1,48 × šířka) */
    .hero__art :global(.hero__drawing) {
      width: auto;
      height: min(var(--hero-art-h), 140cqi);
      max-width: none;
    }

    .hero__art :global(.hero__signature) {
      width: clamp(12rem, 16vw, 17rem);
      margin-top: 0;
      margin-right: 0;
    }
  }

  /* Nástup textu (fade + posun), kresba se „nakreslí“ zdola, podpis se „napíše“ zleva.
     Čisté CSS – bez JS je vše vidět; při omezeném pohybu jen prolnutí průhlednosti. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__in {
      animation: hero-in var(--dur-hero-in) var(--ease-out) both;
      animation-delay: calc(var(--i) * var(--hero-stagger));
    }

    .hero__art :global(.hero__drawing) {
      mask-image: linear-gradient(to top, #000 40%, transparent 60%);
      mask-size: 100% 250%;
      mask-repeat: no-repeat;
      animation: draw-up var(--dur-draw) var(--ease-draw) both;
    }

    .hero__art :global(.hero__signature) {
      mask-image: linear-gradient(to right, #000 40%, transparent 60%);
      mask-size: 250% 100%;
      mask-repeat: no-repeat;
      animation: write-right var(--dur-sign) var(--ease-draw) var(--delay-sign) both;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__dims {
      animation: fade-in var(--dur-dims) ease var(--delay-dims) both;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__dims,
    .hero__in,
    .hero__art :global(.hero__drawing),
    .hero__art :global(.hero__signature) {
      animation: fade-in var(--dur-fade) ease both;
    }
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @keyframes draw-up {
    from {
      mask-position: 0 0%;
    }

    to {
      mask-position: 0 100%;
    }
  }

  @keyframes write-right {
    from {
      mask-position: 100% 0;
    }

    to {
      mask-position: 0 0;
    }
  }

  /* Modely – dva stejně široké sloupce */
  .models__head {
    margin-bottom: var(--space-7);
  }

  .models__head h2,
  .process__head h2,
  .tech__head h2 {
    margin-top: var(--space-3);
  }

  .models__list {
    display: grid;
    gap: var(--space-9) var(--space-8);
  }

  .models__compare {
    margin-top: var(--space-7);
  }

  @media (min-width: 64rem) {
    .models__list {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  /* Odkaz se šipkou */
  .arrow-link {
    display: inline-flex;
    gap: var(--space-2);
    margin-top: var(--space-4);
    font-weight: 500;
    text-decoration: none;
  }

  .arrow-link span[aria-hidden] {
    transition: transform var(--dur-fast) var(--ease);
  }

  .arrow-link:hover span[aria-hidden] {
    transform: translateX(4px);
  }

  /* Koncept */
  .concept {
    display: grid;
    gap: var(--space-7) var(--grid-gap);
  }

  .concept__statement {
    margin-top: var(--space-4);
    max-width: 18ch;
    font-family: var(--font-heading);
    font-size: var(--fs-quote);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .concept__body > * + * {
    margin-top: var(--space-4);
  }

  .concept__sign {
    margin-top: var(--space-5);
  }

  .concept__sign :global(.concept__signature) {
    width: 10rem;
    height: auto;
  }

  @media (min-width: 64rem) {
    .concept {
      grid-template-columns: 5fr 6fr;
      column-gap: var(--space-9);
    }
  }

  /* Proces vývoje */
  .process__head {
    margin-bottom: var(--space-7);
  }

  .process__more {
    margin-top: var(--space-6);
  }

  /* Technologie – jedna fotka + tři sloupce */
  .tech {
    display: grid;
    gap: var(--space-7) var(--grid-gap);
  }

  .tech :global(.tech__photo) {
    max-width: 26rem;
  }

  .tech__head {
    margin-bottom: var(--space-7);
  }

  .tech__cols {
    display: grid;
    gap: var(--space-6) var(--grid-gap);
  }

  .tech__col {
    max-width: none;
  }

  .tech__col h3 {
    font-size: var(--fs-m);
  }

  .tech__col p {
    margin-top: var(--space-3);
  }

  .tech__col .arrow-link {
    margin-top: var(--space-3);
  }

  .tech__more {
    margin-top: var(--space-7);
  }

  @media (min-width: 48rem) {
    .tech__cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .tech {
      grid-template-columns: 4fr 8fr;
      column-gap: var(--space-8);
      align-items: center;
    }

