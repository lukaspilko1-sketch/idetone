---
/** Děkovací stránka po odeslání formuláře bez JS (Formspree _next). Mimo sitemapu, noindex. */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import { cs } from '../i18n/cs';
---

<BaseLayout title="Děkuji | ideTone" description="Zpráva byla odeslána." noindex>
  <PageHeader eyebrow="Odesláno" title={cs.form.success} />
  <Section space="s">
    <div class="actions">
      <Button href="/reprosoustavy/">Prohlédnout modely</Button>
      <Button href="/" variant="secondary">
        Úvodní stránka
      </Button>
    </div>
  </Section>
</BaseLayout>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
