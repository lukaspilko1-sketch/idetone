---
/** Článek deníku – generuje se jen se zapnutým features.journal (koncepty nikdy). */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import { features } from '../../config/site';

export async function getStaticPaths() {
  if (!features.journal) return [];
  const posts = await getCollection('journal', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'journal'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = new Intl.DateTimeFormat('cs-CZ', { dateStyle: 'long' }).format(post.data.date);
---

<BaseLayout title={`${post.data.title} | ideTone`} description={post.data.excerpt}>
  <PageHeader eyebrow={`Deník · ${date}`} title={post.data.title} lead={post.data.excerpt} />
  <Section divider space="m" width="narrow">
    <div class="prose">
      <Content />
    </div>
  </Section>
</BaseLayout>
