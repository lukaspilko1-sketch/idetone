---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactForm from '../components/ContactForm.astro';
import { getPage, getProducts, getSettings } from '../utils/content';
import { typo } from '../utils/format';
import { localBusiness } from '../utils/seo';

const { data } = await getPage('kontakt');
const settings = await getSettings();
const { contact, company, studio, social } = settings;

// Firemní údaje – řádky se zobrazí, až budou vyplněné v settings.yaml
const companyRows = [
  ['Název', company.name],
  ['IČO', company.ico],
  ['DIČ', company.dic],
  ['Sídlo', company.address],
].filter(([, value]) => value);
const models = (await getProducts()).map((p) => ({ id: p.id, name: p.data.name }));
---

<BaseLayout
  title={`${data.seoTitle ?? data.title} | ideTone`}
  description={data.description}
  crumbs={[{ name: 'Kontakt', href: '/kontakt/' }]}
  jsonLd={[localBusiness(settings, Astro.site)]}
>
  <PageHeader eyebrow={data.eyebrow} title={data.title} lead={data.lead} />

  <Section divider space="m" labelledby="kontakt-udaje">
    <h2 id="kontakt-udaje" class="visually-hidden">
      Kontaktní údaje
    </h2>
    <div class="contact">
      <div class="contact__block">
        <span class="eyebrow">Kontaktní osoba</span>
        <p class="contact__name">{contact.person}</p>
        <p>
          <a href={`mailto:${contact.email}`} class="contact__big">
            {contact.email}
          </a>
        </p>
        {contact.phone && (
          <p>
            <a href={`tel:${contact.phone.replace(/\s/g, '')}`} class="contact__big">
              {contact.phone}
            </a>
          </p>
        )}
      </div>

      <div class="contact__block">
        <span class="eyebrow">Poslechové studio</span>
        <address>
          {studio.street}
          <br />
          {studio.city}
        </address>
        {studio.parking && <p class="muted">{typo(studio.parking)}</p>}
        <p class="contact__links mono">
          <a href={studio.mapyCz} rel="noopener">
            Mapy.cz
          </a>
          <a href={studio.googleMaps} rel="noopener">
            Google Maps
          </a>
        </p>
      </div>

      <div class="contact__block">
        {companyRows.length > 0 && (
          <>
            <span class="eyebrow">Fakturační údaje</span>
            <dl class="company mono">
              {companyRows.map(([label, value]) => (
                <div>
                  <dt>{label}</dt>
                  <dd>{value}</dd>
                </div>
              ))}
            </dl>
          </>
        )}
        {social.facebook && (
          <p class="contact__links mono">
            <a href={social.facebook} rel="noopener">
              Facebook
            </a>
          </p>
        )}
      </div>
    </div>
  </Section>

  <Section divider>
    <div class="form-wrap">
      <ContactForm
        type="order"
        id="objednavka"
        title="Objednávka"
        email={contact.email}
        models={models}
      />
    </div>
  </Section>
</BaseLayout>

<style>
  .contact {
    display: grid;
    gap: var(--space-7) var(--grid-gap);
  }

  .contact__block > * + * {
    margin-top: var(--space-3);
  }

  .contact__name {
    font-family: var(--font-heading);
    font-size: var(--fs-l);
  }

  .contact__big {
    font-size: var(--fs-m);
  }

  address {
    font-style: normal;
    font-size: var(--fs-m);
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    font-size: var(--fs-label);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
  }

  .company div {
    display: flex;
    gap: var(--space-3);
    font-size: var(--fs-data);
  }

  .company dt {
    min-width: 4rem;
    color: var(--c-muted);
  }

  @media (min-width: 48rem) {
    .contact {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .form-wrap {
    max-width: 48rem;
  }
</style>
