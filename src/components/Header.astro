---
/**
 * Hlavička (dávka 1.1). Pevně nahoře (fixed), obsah pod ní má rezervu --header-top-h, takže
 * zmenšení po scrollu nehýbe obsahem.
 * Desktop ≥ 64rem: nahoře velké logo na střed, vpravo Objednat, pod tím menu na střed;
 * po scrollu jeden řádek – malé logo vlevo, menu vpravo, Objednat. Přechod animuje polohu a velikost.
 * Mobil: logo na střed, vpravo „Menu“, menu přes celou obrazovku (tmavé sklo).
 */
import Logo from './Logo.astro';
import Button from './Button.astro';
import { nav, orderLink } from '../config/site';
import { cs } from '../i18n/cs';
import { url } from '../utils/url';

const current = Astro.url.pathname;
const isCurrent = (href: string) => current === url(href);
const isSection = (href: string) => current.startsWith(url(href)) && href !== '/';
---

<header class="header" data-header>
  <div class="container header__inner">
    <a href={url('/')} class="header__logo" aria-label={cs.nav.home}>
      <Logo height="var(--header-logo-h)" />
    </a>

    <nav class="nav" id="hlavni-navigace" aria-label={cs.nav.label} data-nav>
      <ul role="list" class="nav__list">
        {nav.map((item) => (
          <li class:list={['nav__item', { 'nav__item--parent': item.children }]}>
            <a
              href={url(item.href)}
              class:list={['nav__link', { 'is-active': isSection(item.href) }]}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
              {item.children && <span class="nav__caret" aria-hidden="true" />}
            </a>
            {item.children && (
              <ul role="list" class="nav__sub">
                {item.children.map((child) => (
                  <li>
                    <a
                      href={url(child.href)}
                      class="nav__sublink"
                      aria-current={isCurrent(child.href) ? 'page' : undefined}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
      <!-- Objednat v mobilním menu -->
      <Button href={orderLink} variant="secondary" class="nav__order">
        {cs.nav.order}
      </Button>
    </nav>

    <!-- Objednat v hlavičce na desktopu -->
    <Button href={orderLink} variant="secondary" class="header__order">
      {cs.nav.order}
    </Button>

    <!-- Bez JS vede „Menu“ na navigaci v patičce, s JS otevírá menu přes celou obrazovku -->
    <a href="#navigace-paticka" class="header__toggle header__toggle--nojs">
      {cs.nav.menu}
    </a>
    <button
      type="button"
      class="header__toggle header__toggle--js"
      aria-expanded="false"
      aria-controls="hlavni-navigace"
      data-nav-toggle
      data-label-open={cs.nav.menu}
      data-label-close={cs.nav.close}
    >
      {cs.nav.menu}
    </button>
  </div>
</header>

<script>
  import { onPage } from '../utils/lifecycle';

  onPage((signal) => {
    const header = document.querySelector<HTMLElement>('[data-header]');
    const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const navEl = document.querySelector<HTMLElement>('[data-nav]');
    if (!header) return;
    document.documentElement.classList.remove('is-locked');

    // Zmenšení hlavičky po odscrollování
    let ticking = false;
    const update = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 8);
      ticking = false;
    };
    update();
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true, signal },
    );

    if (!toggle || !navEl) return;

    // Mobilní menu přes celou obrazovku
    const setOpen = (open: boolean) => {
      header.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.textContent = (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '';
      document.documentElement.classList.toggle('is-locked', open);
      if (open) navEl.querySelector<HTMLElement>('a')?.focus();
    };

    toggle.addEventListener(
      'click',
      () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'),
      {
        signal,
      },
    );

    document.addEventListener(
      'keydown',
      (e) => {
        if (e.key === 'Escape' && header.classList.contains('is-open')) {
          setOpen(false);
          toggle.focus();
        }
      },
      { signal },
    );

    // Udržet focus v otevřeném menu (odkazy a tlačítko Zavřít)
    header.addEventListener(
      'keydown',
      (e) => {
        if (e.key !== 'Tab' || !header.classList.contains('is-open')) return;
        const focusables = [...navEl.querySelectorAll<HTMLElement>('a'), toggle];
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      },
      { signal },
    );

    // Při přechodu na desktop menu zavřít
    window.matchMedia('(min-width: 64rem)').addEventListener(
      'change',
      (e) => {
        if (e.matches) setOpen(false);
      },
      { signal },
    );
  });
</script>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    background: var(--c-len);
    border-bottom: 1px solid var(--c-line);
    transition:
      background-color var(--dur-header) var(--ease),
      border-color var(--dur-header) var(--ease);
  }

  /* Po odscrollování světlé sklo (čitelnost: vysoká neprůhlednost + linka) */
  .header.is-scrolled {
    background: var(--glass-header);
    backdrop-filter: blur(16px) saturate(1.1);
    -webkit-backdrop-filter: blur(16px) saturate(1.1);
  }

  .header__inner {
    --header-logo-h: var(--logo-top-h);
    position: relative;
    height: var(--header-top-h);
    transition: height var(--dur-header) var(--ease);
  }

  .header.is-scrolled .header__inner {
    --header-logo-h: var(--logo-scrolled-h);
    height: var(--header-scrolled-h);
  }

  /* Logo – mobil: vždy na střed */
  .header__logo {
    position: absolute;
    z-index: 2;
    top: 50%;
    left: 50%;
    display: block;
    padding-block: var(--space-2);
    transform: translate(-50%, -50%);
    transition:
      top var(--dur-header) var(--ease),
      left var(--dur-header) var(--ease),
      transform var(--dur-header) var(--ease);
  }

  .header__logo :global(.logo) {
    transition: height var(--dur-header) var(--ease);
  }

  .nav__link,
  .nav__sublink {
    color: var(--c-grafit);
    text-decoration: none;
  }

  /* Šipka u položky s podmenu (CSS, nezávislá na písmu) */
  .nav__caret {
    display: inline-block;
    width: 0.4em;
    height: 0.4em;
    margin-left: 0.5em;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-0.2em) rotate(45deg);
  }

  /* „Objednat“ v hlavičce jen na desktopu */
  .header :global(.header__order) {
    display: none;
  }

  /* Omezený pohyb: hlavička se přepne bez animace polohy a velikosti */
  @media (prefers-reduced-motion: reduce) {
    .header__inner,
    .header__logo,
    .header__logo :global(.logo),
    .nav,
    .header :global(.header__order) {
      transition: none;
    }
  }

  /* Desktop */
  @media (min-width: 64rem) {
    .header__toggle {
      display: none;
    }

    .header__logo {
      top: var(--header-pad);
      left: 50%;
      transform: translate(-50%, 0);
    }

    .header.is-scrolled .header__logo {
      top: 50%;
      left: var(--gutter);
      transform: translate(0, -50%);
    }

    .nav {
      position: absolute;
      bottom: var(--space-3);
      left: 50%;
      transform: translate(-50%, 0);
      transition:
        left var(--dur-header) var(--ease),
        bottom var(--dur-header) var(--ease),
        transform var(--dur-header) var(--ease);
    }

    .header.is-scrolled .nav {
      bottom: 50%;
      left: calc(100% - var(--gutter) - var(--order-w) - var(--space-6));
      transform: translate(-100%, 50%);
    }

    .nav :global(.nav__order) {
      display: none;
    }

    .nav__list {
      display: flex;
      gap: var(--space-6);
    }

    .nav__item {
      position: relative;
    }

    .nav__link {
      display: inline-block;
      padding-block: var(--space-2);
      font-size: var(--fs-small);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.09em;
      white-space: nowrap;
      border-bottom: 1px solid transparent;
    }

    .nav__link:hover,
    .nav__link.is-active,
    .nav__link[aria-current='page'] {
      border-bottom-color: var(--c-dub);
    }

    .header :global(.header__order) {
      position: absolute;
      top: calc(var(--header-pad) + (var(--logo-top-h) - 2.875rem) / 2);
      right: var(--gutter);
      display: inline-flex;
      width: var(--order-w);
      transition:
        top var(--dur-header) var(--ease),
        transform var(--dur-header) var(--ease);
    }

    .header.is-scrolled :global(.header__order) {
      top: 50%;
      transform: translateY(-50%);
    }

    /* Podmenu */
    .nav__sub {
      position: absolute;
      top: 100%;
      left: calc(-1 * var(--space-4));
      min-width: 14rem;
      padding: var(--space-2) var(--space-4);
      background: var(--c-papir);
      border: var(--border);
      border-radius: var(--radius);
      opacity: 0;
      visibility: hidden;
      transform: translateY(4px);
      transition:
        opacity var(--dur-fast) var(--ease),
        transform var(--dur-fast) var(--ease),
        visibility var(--dur-fast);
    }

    .nav__sub .nav__sublink {
      display: block;
      padding-block: var(--space-2);
    }

    .nav__sublink:hover,
    .nav__sublink[aria-current='page'] {
      color: var(--c-dub-text);
    }

    .nav__item--parent:hover .nav__sub,
    .nav__item--parent:focus-within .nav__sub {
      opacity: 1;
      visibility: visible;
      transform: none;
    }
  }

  /* Mobil a tablet */
  @media (max-width: 63.99rem) {
    .header__toggle {
      position: absolute;
      z-index: 2;
      top: 50%;
      right: var(--gutter);
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
      padding: var(--space-2) 0;
      background: none;
      border: 0;
      font-family: var(--font-mono);
      font-size: var(--fs-label);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: var(--tracking-eyebrow);
      color: var(--c-grafit);
      text-decoration: none;
      cursor: pointer;
      transform: translateY(-50%);
    }

    :global(.js) .header__toggle--nojs,
    :global(html:not(.js)) .header__toggle--js {
      display: none;
    }

    .nav {
      display: none;
    }

    .header.is-open .nav {
      position: fixed;
      inset: 0;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: space-between;
      gap: var(--space-7);
      padding: calc(var(--header-top-h) + var(--space-6)) var(--gutter) var(--space-7);
      overflow-y: auto;
      /* Menu jako tmavé sklo přes stránku */
      background: var(--glass-overlay);
      backdrop-filter: blur(24px) saturate(1.2);
      -webkit-backdrop-filter: blur(24px) saturate(1.2);
    }

    /* Otevřené menu: hlavička bez skla (backdrop-filter by uzavřel fixed menu do hlavičky) */
    .header.is-open {
      background: transparent;
      border-bottom-color: transparent;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    .header.is-open .header__toggle {
      color: var(--c-on-dark);
    }

    .header.is-open :global(.logo__ide) {
      fill: var(--c-on-dark);
    }

    .header.is-open :global(.logo__tone) {
      fill: var(--c-dub-light);
    }

    .nav__list {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }

    .nav__link {
      font-family: var(--font-heading);
      font-size: var(--fs-xl);
      color: var(--c-on-dark);
    }

    .nav__caret {
      display: none;
    }

    .nav__link[aria-current='page'],
    .nav__link.is-active {
      color: var(--c-dub-light);
    }

    .nav__sub {
      padding: var(--space-1) 0 0 var(--space-4);
      border-left: 1px solid var(--c-line-dark);
    }

    .nav__sublink {
      display: block;
      padding-block: var(--space-1);
      font-size: var(--fs-m);
      color: var(--c-on-dark-muted);
    }

    .nav__sublink:hover,
    .nav__sublink[aria-current='page'] {
      color: var(--c-on-dark);
    }

    .nav :global(.nav__order) {
      border-color: var(--c-on-dark);
      color: var(--c-on-dark);
    }

    .nav :global(.nav__order:hover) {
      background: var(--c-uhel-hover);
      color: var(--c-on-dark);
    }
  }
</style>
