---
/**
 * Místo pro fotku s pevným poměrem stran. Když fotka chybí, zobrazí se placeholder s popiskem.
 * Výměna fotky = nový soubor a změna cesty v Markdownu (src se předá jako ImageMetadata).
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  ratio?: '4/5' | '16/9' | '1/1' | '3/2';
  /** popisek placeholderu, např. „Foto: Sara v obývacím pokoji“ */
  label: string;
  src?: ImageMetadata;
  alt?: string;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const {
  ratio = '3/2',
  label,
  src,
  alt = '',
  sizes = '(min-width: 1200px) 600px, 100vw',
  loading = 'lazy',
  class: className,
} = Astro.props;

const ratioLabel = ratio.replace('/', ':');
---

<figure class:list={['slot', className]} style={`--ratio: ${ratio}`}>
  {src ? (
    <Image
      src={src}
      alt={alt}
      sizes={sizes}
      widths={[480, 800, 1200, 1600].filter((w) => w <= src.width)}
      loading={loading}
      class="slot__img"
    />
  ) : (
    <div
      class="slot__placeholder"
      role="img"
      aria-label={`Připravené místo pro fotografii: ${label}`}
    >
      <span class="slot__label">
        {label}, {ratioLabel}
      </span>
    </div>
  )}
</figure>

<style>
  .slot {
    aspect-ratio: var(--ratio);
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .slot__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .slot__placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    padding: var(--space-5);
    background: var(--c-papir);
    border: 1px dashed var(--c-line);
  }

  .slot__label {
    max-width: 28ch;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.02em;
    color: var(--c-muted);
    text-align: center;
  }
</style>
