---
/**
 * Dočasné místo pro formulář (ContactForm vznikne ve fázi F3).
 * TODO(lukas): nahradit komponentou ContactForm ve fázi F3
 */
interface Props {
  id: string;
  title: string;
  email: string;
  subject: string;
}

const { id, title, email, subject } = Astro.props;
---

<section class="form-placeholder" id={id} aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`} class="h3">
    {title}
  </h2>
  <p class="muted">
    Formulář připravujeme. Zatím prosím napište e-mail na
    <a href={`mailto:${email}?subject=${encodeURIComponent(subject)}`}>{email}</a>.
  </p>
</section>

<style>
  .form-placeholder {
    padding: clamp(var(--space-5), 4vw, var(--space-7));
    background: var(--c-papir);
    border: var(--border);
    border-radius: var(--radius);
  }

  p {
    margin-top: var(--space-3);
  }
</style>
