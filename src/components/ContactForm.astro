---
/**
 * Formulář přes Formspree – jedna komponenta a stejná pole pro tři stránky (dávka 9.5 / 9.10):
 * contact (Kontakt – obecný dotaz), listening (Poslech), custom (Zakázkové projekty).
 * Pole: jméno*, e-mail*, telefon, zpráva*, souhlas*. Liší se jen nadpis, tlačítko, předmět a nápověda.
 * ?model=sara předvyplní zprávu a doplní model do předmětu (jen contact).
 * S JS: validace s českými hláškami, odeslání přes fetch (JSON), stavy odesílám / úspěch / chyba.
 * Bez JS: klasický POST na Formspree (+ _next na /dekujeme/, funguje jen v placeném tarifu Formspree).
 */
import { formspree } from '../config/site';
import { cs } from '../i18n/cs';
import { url } from '../utils/url';

type FormType = 'contact' | 'listening' | 'custom';

interface Props {
  type: FormType;
  /** kotva sekce (#formular, #poptavka) */
  id: string;
  title: string;
  email: string;
  /** modely pro předvyplnění zprávy z ?model= (id → název) */
  models?: { id: string; name: string }[];
}

const { type, id, title, email, models = [] } = Astro.props;
const t = cs.form;
const f = t.fields;
const hint = f.messageHint[type];

const formId = formspree[type];
const endpoint = formId ? `https://formspree.io/f/${formId}` : '';
const thanks = new URL(url('/dekujeme/'), Astro.site).href;
const p = (name: string) => `${type}-${name}`; // unikátní id polí

const messages = {
  ...t.errors,
  success: t.success,
  sending: t.sending,
  subject: t.subject[type],
  modelMessage: t.modelMessage,
};
---

<section class="cf glass-card" id={id} aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`} class="cf__title">
    {title}
  </h2>
  <slot />

  {import.meta.env.DEV && !formId && <p class="cf__dev mono">{t.devInactive}</p>}

  <form
    class="cf__form"
    action={endpoint || undefined}
    method="POST"
    data-cf
    data-type={type}
    data-endpoint={endpoint}
    data-email={email}
    data-messages={JSON.stringify(messages)}
  >
    <input type="hidden" name="_subject" value={t.subject[type]} data-subject />
    <input type="hidden" name="_next" value={thanks} />
    <!-- Antispam: pole, které člověk nevidí a nevyplní -->
    <div class="cf__trap" aria-hidden="true">
      <label for={p('gotcha')}>Nevyplňujte</label>
      <input type="text" id={p('gotcha')} name="_gotcha" tabindex="-1" autocomplete="off" />
    </div>

    <p class="cf__legend small muted">
      <span aria-hidden="true">*</span> {t.required}
    </p>

    <div class="cf__row">
      <div class="cf__field" data-field>
        <label for={p('name')}>
          {f.name} <span aria-hidden="true">*</span>
        </label>
        <input
          type="text"
          id={p('name')}
          name="Jméno a příjmení"
          autocomplete="name"
          required
          data-label={f.name}
        />
        <p class="cf__error" id={`${p('name')}-error`} hidden></p>
      </div>
      <div class="cf__field" data-field>
        <label for={p('email')}>
          {f.email} <span aria-hidden="true">*</span>
        </label>
        <input
          type="email"
          id={p('email')}
          name="email"
          autocomplete="email"
          required
          data-label={f.email}
        />
        <p class="cf__error" id={`${p('email')}-error`} hidden></p>
      </div>
      <div class="cf__field" data-field>
        <label for={p('phone')}>
          {f.phone} <span class="muted small">({t.optional})</span>
        </label>
        <input
          type="tel"
          id={p('phone')}
          name="Telefon"
          autocomplete="tel"
          inputmode="tel"
          pattern="[+]?[0-9 ]{9,17}"
          data-label={f.phone}
        />
        <p class="cf__error" id={`${p('phone')}-error`} hidden></p>
      </div>
    </div>

    <div class="cf__field" data-field>
      <label for={p('message')}>
        {f.message} <span aria-hidden="true">*</span>
      </label>
      {hint && (
        <p class="cf__hint small muted" id={`${p('message')}-hint`}>
          {hint}
        </p>
      )}
      <textarea
        id={p('message')}
        name="Zpráva"
        rows="5"
        required
        data-label={f.message}
        data-message
        data-models={JSON.stringify(models)}
        aria-describedby={hint ? `${p('message')}-hint` : undefined}
      ></textarea>
      <p class="cf__error" id={`${p('message')}-error`} hidden></p>
    </div>

    <div class="cf__field cf__consent" data-field>
      <label>
        <input
          type="checkbox"
          id={p('consent')}
          name="Souhlas se zpracováním údajů"
          value="ano"
          required
          data-consent
        />
        <span>
          {f.consent} <a href={url('/ochrana-osobnich-udaju/')}>{f.consentLink}</a>{' '}
          <span aria-hidden="true">*</span>
        </span>
      </label>
      <p class="cf__error" id={`${p('consent')}-error`} hidden></p>
    </div>

    <div class="cf__status" role="alert" aria-live="assertive" data-status hidden></div>

    <button type="submit" class="btn btn--primary cf__submit" data-submit>
      <span data-submit-label>{t.submit[type]}</span>
      <span class="btn__arrow" aria-hidden="true">
        →
      </span>
    </button>
  </form>

  <div class="cf__success" role="status" tabindex="-1" data-success hidden>
    <p class="cf__success-text">{t.success}</p>
  </div>
</section>

<script>
  import { onPage } from '../utils/lifecycle';

  type Messages = Record<string, string>;

  const fill = (text: string, vars: Record<string, string>) =>
    text.replace(/\{(\w+)\}/g, (_, key) => vars[key] ?? '');

  onPage(() => {
    document.querySelectorAll<HTMLFormElement>('[data-cf]').forEach((form) => {
      const msg: Messages = JSON.parse(form.dataset.messages ?? '{}');
      const email = form.dataset.email ?? '';
      const status = form.querySelector<HTMLElement>('[data-status]')!;
      const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
      const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]')!;
      const defaultLabel = submitLabel.textContent ?? '';
      const success = form.parentElement?.querySelector<HTMLElement>('[data-success]');
      const message = form.querySelector<HTMLTextAreaElement>('[data-message]');
      const subject = form.querySelector<HTMLInputElement>('[data-subject]');
      let attempted = false;

      // Vlastní validace (bez JS platí validace prohlížeče)
      form.noValidate = true;

      // ?model=sara → předvyplněná zpráva (lze upravit) a model v předmětu
      const wanted = new URLSearchParams(location.search).get('model');
      const models: { id: string; name: string }[] = JSON.parse(message?.dataset.models ?? '[]');
      const picked = models.find((m) => m.id === wanted);
      if (picked && message && subject) {
        if (!message.value) message.value = fill(msg.modelMessage, { model: picked.name });
        subject.value = `${msg.subject} (${picked.name})`;
      }

      const fieldError = (input: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement) => {
        const v = input.validity;
        if (v.valid) return '';
        if (input.type === 'checkbox') return msg.consent;
        if (v.valueMissing) return fill(msg.required, { label: input.dataset.label ?? '' });
        if (input.type === 'email') return msg.email;
        if (input.type === 'tel') return msg.phone;
        return fill(msg.required, { label: input.dataset.label ?? '' });
      };

      const showError = (
        input: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement,
        text: string,
      ) => {
        const box = form.querySelector<HTMLElement>(`#${CSS.escape(input.id)}-error`);
        if (!box) return;
        box.textContent = text;
        box.hidden = !text;
        const hintId = form.querySelector(`#${CSS.escape(input.id)}-hint`)?.id;
        const describedBy = [hintId, text ? box.id : ''].filter(Boolean).join(' ');
        if (describedBy) input.setAttribute('aria-describedby', describedBy);
        else input.removeAttribute('aria-describedby');
        if (text) input.setAttribute('aria-invalid', 'true');
        else input.removeAttribute('aria-invalid');
      };

      const validate = () => {
        const inputs = [
          ...form.querySelectorAll<HTMLInputElement>('input[required], textarea[required]'),
          ...form.querySelectorAll<HTMLInputElement>('input[type="email"], input[type="tel"]'),
        ];
        let first: HTMLElement | null = null;
        for (const input of new Set(inputs)) {
          const text = fieldError(input);
          showError(input, text);
          if (text && !first) first = input;
        }
        return first;
      };

      form.addEventListener('input', () => {
        if (attempted) validate();
      });

      const setStatus = (text: string) => {
        status.textContent = text;
        status.hidden = !text;
      };

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        attempted = true;
        setStatus('');

        const invalid = validate();
        if (invalid) {
          setStatus(msg.summary);
          invalid.focus();
          return;
        }

        const endpoint = form.dataset.endpoint;
        if (!endpoint) {
          setStatus(fill(msg.inactive, { email }));
          return;
        }

        const data = Object.fromEntries(new FormData(form));
        delete data._next;

        submit.disabled = true;
        submitLabel.textContent = msg.sending;
        form.setAttribute('aria-busy', 'true');

        try {
          const res = await fetch(endpoint, {
            method: 'POST',
            headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
            body: JSON.stringify(data),
          });
          if (res.ok) {
            form.hidden = true;
            if (success) {
              success.hidden = false;
              success.focus();
            }
            return;
          }
          // Chyby u konkrétních polí z Formspree (např. neplatný e-mail)
          const body = await res.json().catch(() => ({}));
          const errors: { field?: string; message?: string }[] = body.errors ?? [];
          let marked = false;
          for (const err of errors) {
            const input = err.field
              ? form.querySelector<HTMLInputElement>(`[name="${CSS.escape(err.field)}"]`)
              : null;
            if (input?.id) {
              showError(input, input.type === 'email' ? msg.email : (err.message ?? ''));
              marked = true;
            }
          }
          setStatus(marked ? msg.summary : fill(msg.server, { email }));
        } catch {
          setStatus(fill(msg.network, { email }));
        } finally {
          submit.disabled = false;
          submitLabel.textContent = defaultLabel;
          form.removeAttribute('aria-busy');
        }
      });
    });
  });
</script>

<style>
  .cf {
    padding: var(--card-pad, var(--space-5));
  }

  .cf__title {
    font-size: var(--fs-l);
  }

  .cf__dev {
    margin-top: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border: 1px dashed var(--c-dub);
    border-radius: var(--radius-s);
    font-size: var(--fs-small);
    color: var(--c-dub-ink);
  }

  .cf__form {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-5);
  }

  .cf__form[hidden],
  .cf__status[hidden],
  .cf__success[hidden] {
    display: none;
  }

  .cf__legend {
    margin-bottom: calc(-1 * var(--space-2));
  }

  .cf__row {
    display: grid;
    gap: var(--space-5) var(--space-4);
  }

  @media (min-width: 40rem) {
    .cf__row {
      grid-template-columns: 1fr 1fr;
    }

    .cf__row > :first-child {
      grid-column: 1 / -1;
    }
  }

  .cf__field {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .cf__field[hidden] {
    display: none;
  }

  label {
    font-weight: 500;
  }

  input[type='text'],
  input[type='email'],
  input[type='tel'],
  textarea {
    width: 100%;
    min-height: 2.875rem;
    padding: var(--space-3) var(--space-4);
    background: var(--c-field);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-s);
    font-size: var(--fs-body);
    line-height: 1.4;
    transition: border-color var(--dur-fast) var(--ease);
  }

  textarea {
    resize: vertical;
  }

  input:hover,
  textarea:hover {
    border-color: var(--c-muted);
  }

  input:focus-visible,
  textarea:focus-visible {
    outline: var(--focus);
    outline-offset: 0;
    border-color: var(--c-dub);
  }

  [aria-invalid='true'] {
    border-color: var(--c-error);
  }

  input[type='checkbox'] {
    border-radius: var(--radius-xs);
    width: 1.125rem;
    height: 1.125rem;
    margin: 0;
    flex: none;
    accent-color: var(--c-dub-text);
  }

  .cf__consent label {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-weight: 400;
    font-size: var(--fs-small);
    line-height: 1.5;
  }

  .cf__consent input {
    margin-top: 0.1rem;
  }

  .cf__hint {
    margin: 0;
  }

  .cf__error {
    margin: 0;
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--c-error);
  }

  .cf__status {
    padding: var(--space-3) var(--space-4);
    border-left: 2px solid var(--c-error);
    background: var(--c-len);
    border-radius: var(--radius-s);
    font-size: var(--fs-small);
    color: var(--c-grafit);
  }

  .cf__submit {
    justify-self: start;
  }

  .cf__submit:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .cf__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .cf__success {
    margin-top: var(--space-5);
    padding: var(--space-6);
    background: var(--c-uhel);
    color: var(--c-on-dark);
    border-radius: var(--radius-m);
  }

  .cf__success:focus {
    outline: var(--focus);
    outline-offset: 3px;
  }

  .cf__success-text {
    font-family: var(--font-heading);
    font-size: var(--fs-l);
  }
</style>
