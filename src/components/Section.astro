---
/**
 * Otevřená sekce stránky. Sekce se oddělují linkou a mezerou, ne kartami.
 * tone: len (výchozí), papir, uhel. divider = linka nahoře. space = rytmus mezer.
 * Tón uhel má skleněné pozadí (GlassBackdrop), glass = výřez fotky, která prosvítá.
 */
import type { ImageMetadata } from 'astro';
import GlassBackdrop from './GlassBackdrop.astro';

interface Props {
  as?: 'section' | 'div' | 'aside' | 'article';
  id?: string;
  /** dub = pruh z ořechového dřeva (dávka 4.2), max. jedna dubová plocha na stránce;
   *  dark = grafitový pruh bez fotky (dávka 11.1, sekce Technologie na úvodu) */
  tone?: 'len' | 'papir' | 'uhel' | 'dub' | 'dark';
  divider?: boolean;
  space?: 'none' | 's' | 'm' | 'l';
  /** šířka obsahu: container = 1200 px, narrow = šířka odstavce, full = bez kontejneru */
  width?: 'container' | 'narrow' | 'full';
  reveal?: boolean;
  labelledby?: string;
  /** výřez prosvítající fotky u tónu uhel (CSS background-position) */
  glass?: string;
  /** fotka prosvítající za sklem u tónu uhel (jinak výchozí fotka dřeva) */
  glassImage?: ImageMetadata;
  class?: string;
}

const {
  as: Tag = 'section',
  id,
  tone = 'len',
  divider = false,
  space = 'l',
  width = 'container',
  reveal = true,
  labelledby,
  glass,
  glassImage,
  class: className,
} = Astro.props;
---

<Tag
  id={id}
  class:list={[
    'section',
    `section--${tone}`,
    `section--space-${space}`,
    { 'section--divider': divider },
    className,
  ]}
  aria-labelledby={labelledby}
>
  {tone === 'uhel' && <GlassBackdrop position={glass} image={glassImage} />}
  {width === 'full' ? (
    <slot />
  ) : (
    <div
      class:list={['container', { section__narrow: width === 'narrow' }]}
      data-reveal={reveal ? '' : undefined}
    >
      <slot />
    </div>
  )}
</Tag>

<style>
  /* Dávka 10: pásy 1 / 2 se střídají (pořadí řeší base.css přes --band), záře dává sklu co rozostřit.
     overflow: clip (ne hidden) – nerozbije lepivé panely (position: sticky) uvnitř sekce */
  .section--len,
  .section--papir {
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: var(--band, var(--band-1));
  }

  .section--len::before,
  .section--papir::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(480px 340px at 10% 35%, rgb(168 116 63 / var(--glow)), transparent 70%),
      radial-gradient(
        560px 380px at 88% 75%,
        rgb(255 255 255 / calc(var(--glow) * 2.4)),
        transparent 70%
      ),
      radial-gradient(
        300px 220px at 55% 10%,
        rgb(138 92 46 / calc(var(--glow) * 0.7)),
        transparent 70%
      );
  }

  .section--uhel {
    position: relative;
    isolation: isolate;
    background: var(--c-uhel);
    color: var(--c-on-dark);
  }

  .section--uhel :global(.eyebrow),
  .section--uhel :global(.muted) {
    color: var(--c-on-dark-muted);
  }

  .section--uhel :global(a:not(.btn):not(.link)) {
    color: var(--c-on-dark);
  }

  /* Grafitový pruh (dávka 11.1): plná barva, záře vpravo nahoře, bez fotky */
  .section--dark {
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: var(--band-dark);
    color: #f1ece2;
  }

  .section--dark::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(520px 360px at 85% 20%, rgb(201 149 96 / 0.22), transparent 70%);
  }

  .section--dark :global(.eyebrow) {
    color: #e5c9a2;
  }

  .section--dark :global(.muted),
  .section--dark :global(.small) {
    color: #cfc8ba;
  }

  .section--dark :global(h1),
  .section--dark :global(h2),
  .section--dark :global(h3) {
    color: #fff;
  }

  .section--dark :global(a:not(.btn):not(.link)) {
    color: #f1ece2;
  }

  .section--dark :global(.glass-card) {
    background: rgb(255 255 255 / 0.06);
    border-color: rgb(255 255 255 / 0.12);
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  /* Ořechové dřevo: text v plné světlé barvě (malý text v --c-on-wood-muted by nesplnil AA) */
  .section--dub {
    background: var(--wood-gradient);
    color: var(--c-on-wood);
  }

  .section--dub :global(.eyebrow),
  .section--dub :global(.muted),
  .section--dub :global(a:not(.btn):not(.link)) {
    color: var(--c-on-wood);
  }

  /* Dávka 9.6: všechny velikosti odvozené z jednoho tokenu --section-space */
  .section--space-s {
    padding-block: max(var(--space-6), calc(var(--section-space) / 2));
  }

  .section--space-m {
    padding-block: max(var(--space-7), calc(var(--section-space) * 0.75));
  }

  /* 9b.1: mobil – pás střední velikosti o 16 px nižší (desktop beze změny) */
  @media (max-width: 47.99rem) {
    .section--space-m {
      padding-block: var(--space-6);
    }
  }

  .section--space-l {
    padding-block: var(--section-space);
  }

  .section--space-none {
    padding-block: 0;
  }

  /* Linka nahoře: oddělí sekci od předchozí na stejném pozadí */
  .section--divider {
    padding-top: 0;
  }

  .section--divider > .container::before {
    content: '';
    display: block;
    height: 1px;
    margin-bottom: var(--section-space);
    background: linear-gradient(90deg, var(--c-dub), transparent 40%);
    opacity: 0.5;
  }

  .section__narrow > :global(*) {
    max-width: var(--measure);
  }
</style>
