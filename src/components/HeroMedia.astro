---
/**
 * Pozadí hero za sklem (dávka 1.3): rozostřená fotka s pomalým „Ken Burns“, nebo krátké video
 * (webm/mp4 z public/, muted autoplay loop playsinline, fotka jako poster).
 * Výměna fotky za video = doplnit `background.video` v home.yaml.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import GlassBackdrop from './GlassBackdrop.astro';
import { url } from '../utils/url';

interface Props {
  image: ImageMetadata;
  video?: string;
  videoMp4?: string;
  position?: string;
  class?: string;
}

const { image, video, videoMp4, position = '50% 50%', class: className } = Astro.props;
const poster = video || videoMp4 ? await getImage({ src: image, width: 1200, format: 'webp' }) : undefined;
---

<div class:list={['hero-media', className]} aria-hidden="true">
  {
    video || videoMp4 ? (
      <>
        <video
          class="hero-media__video"
          muted
          autoplay
          loop
          playsinline
          preload="metadata"
          poster={poster?.src}
          data-hero-video
        >
          {video && <source src={url(video)} type="video/webm" />}
          {videoMp4 && <source src={url(videoMp4)} type="video/mp4" />}
        </video>
        <div class="hero-media__tint" />
      </>
    ) : (
      <GlassBackdrop image={image} position={position} animated />
    )
  }
</div>

<script>
  import { onPage } from '../utils/lifecycle';

  // Při omezeném pohybu video nepřehrávat (zůstane poster)
  onPage(() => {
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll<HTMLVideoElement>('[data-hero-video]').forEach((v) => {
      v.removeAttribute('autoplay');
      v.pause();
    });
  });
</script>

<style>
  .hero-media {
    position: absolute;
    z-index: -1;
    overflow: hidden;
    isolation: isolate;
    background: var(--c-uhel);
  }

  .hero-media__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(6px) saturate(0.9);
    transform: scale(1.05);
  }

  .hero-media__tint {
    position: absolute;
    inset: 0;
    background: var(--glass-tint);
  }
</style>
