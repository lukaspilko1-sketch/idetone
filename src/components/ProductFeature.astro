---
/**
 * Produktový blok (úvod, přehled modelů). Záměrně nejsou dvě stejné karty:
 * „tall“ = vysoká sloupová (fotka vedle textu), „compact“ = kompaktní (menší fotka / silueta),
 * „column“ = sloupec na úvodu: fotka nahoře ve stejně vysoké „scéně“ (stejná podlaha), text pod ní.
 * Rozvržení řídí container queries – blok se přizpůsobí šířce sloupce, ve kterém je.
 * Název modelu jako značka (--fs-model), cena jen se showPrice.
 */
import { Picture } from 'astro:assets';
import ProductSilhouette from './ProductSilhouette.astro';
import { shortSpec, specLabels, type Product } from '../utils/content';
import { formatPrice, typo } from '../utils/format';
import { url } from '../utils/url';

interface Props {
  product: Product;
  variant?: 'tall' | 'compact' | 'column';
  level?: 2 | 3;
  /** delší popis místo jedné věty (přehled modelů) */
  long?: boolean;
  showPrice?: boolean;
  /** klíčové parametry (na úvodu ne – jen detail a srovnání) */
  showSpecs?: boolean;
}

const {
  product,
  variant = 'tall',
  level = 3,
  long = false,
  showPrice = true,
  showSpecs = true,
} = Astro.props;
const { data } = product;
const H = `h${level}` as 'h2' | 'h3';
const href = url(`/reprosoustavy/${product.id}/`);
---

<article class:list={['pf', `pf--${variant}`]}>
  <div class="pf__layout">
    <a class="pf__media" href={href} tabindex="-1" aria-hidden="true" data-reveal-img>
      {data.image ? (
        <div class="pf__frame" transition:name={`model-${product.id}`}>
          <Picture
            src={data.image.src}
            alt=""
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[320, 560, 800].filter((w) => w <= data.image!.src.width)}
            sizes={
              variant === 'compact'
                ? '(min-width: 64rem) 220px, 50vw'
                : '(min-width: 64rem) 300px, 60vw'
            }
            class="pf__img"
          />
        </div>
      ) : (
        <div class="pf__frame" transition:name={`model-${product.id}`}>
          <ProductSilhouette name={data.name} />
        </div>
      )}
    </a>

    <div class="pf__body" data-reveal>
      <span class="eyebrow">{data.type}</span>
      <H class="pf__name">
        <a href={href}>
          {data.name}
          <span class="pf__arrow" aria-hidden="true">
            →
          </span>
        </a>
      </H>
      <p class="pf__text">{typo(long ? data.intro : data.tagline)}</p>

      {showSpecs && (
        <dl class="pf__specs">
          {data.highlights.map((key) => (
            <div>
              <dt>{specLabels[key]}</dt>
              <dd>{typo(shortSpec(product, key))}</dd>
            </div>
          ))}
        </dl>
      )}

      {showPrice && (
        <p class="pf__price">
          <span class="price">{formatPrice(data.price)}</span>
          <span class="muted small"> / pár</span>
        </p>
      )}

      <a class="pf__link" href={href}>
        Detail modelu {data.name}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</article>

<style>
  .pf {
    container-type: inline-size;
  }

  .pf__layout {
    display: grid;
    gap: var(--space-6);
    align-items: end;
  }

  .pf__media {
    display: block;
    width: min(100%, var(--pf-media-w, 16rem));
    text-decoration: none;
  }

  .pf--compact .pf__media {
    --pf-media-w: 8rem;
  }

  .pf__frame {
    transition: transform var(--dur-hover-img) var(--ease-out);
  }

  .pf__media :global(.pf__img) {
    width: 100%;
    height: auto;
    filter: var(--product-shadow);
  }

  /* Hover: fotka se jemně zvětší, šipka u názvu se posune */
  @media (hover: hover) {
    .pf:hover .pf__frame {
      transform: scale(1.03);
    }

    .pf:hover .pf__arrow {
      transform: translateX(6px);
      opacity: 1;
    }
  }

  .pf__name {
    margin-top: var(--space-2);
    font-size: var(--fs-model);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.02em;
  }

  /* Sloupec na úvodu: název o 20 % menší než na přehledu a detailu */
  .pf--column .pf__name {
    font-size: calc(var(--fs-model) * 0.8);
  }

  .pf__name a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.15em;
    color: inherit;
    text-decoration: none;
  }

  .pf__arrow {
    font-size: 0.35em;
    opacity: 0.4;
    transition:
      transform var(--dur-fast) var(--ease),
      opacity var(--dur-fast) var(--ease);
  }

  .pf__text {
    margin-top: var(--space-4);
    max-width: 38ch;
  }

  .pf__specs {
    display: grid;
    margin-top: var(--space-5);
    border-top: var(--border);
    font-family: var(--font-mono);
    font-size: var(--fs-data);
  }

  .pf__specs div {
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    gap: var(--space-3);
    padding-block: var(--space-2);
    border-bottom: var(--border);
  }

  .pf__specs dt {
    color: var(--c-muted);
  }

  .pf__price {
    margin-top: var(--space-5);
  }

  .pf__price .price {
    font-size: var(--fs-l);
  }

  .pf__link {
    display: inline-flex;
    gap: var(--space-2);
    margin-top: var(--space-4);
    font-weight: 500;
    text-decoration: none;
  }

  .pf__link span {
    transition: transform var(--dur-fast) var(--ease);
  }

  .pf__link:hover span {
    transform: translateX(4px);
  }

  /* Sloupec na úvodu: stejně vysoká scéna pro fotku, fotka i silueta stojí na stejné „podlaze“ */
  .pf--column .pf__layout {
    align-items: start;
  }

  .pf--column .pf__media {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: 100%;
    height: var(--pf-stage-h);
  }

  .pf--column .pf__frame {
    height: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  .pf--column .pf__media :global(picture) {
    display: contents;
  }

  .pf--column .pf__media :global(.pf__img) {
    width: auto;
    height: 100%;
    max-width: 100%;
    object-fit: contain;
    object-position: bottom;
  }

  /* Silueta stojí na stejné podlaze jako fotka, popisek visí pod podlahou */
  .pf--column .pf__media :global(.silhouette) {
    position: relative;
    display: block;
    height: 92%;
  }

  .pf--column .pf__media :global(.silhouette svg) {
    width: auto;
    height: 100%;
  }

  .pf--column .pf__media :global(.silhouette__label) {
    position: absolute;
    top: 100%;
    left: 50%;
    margin-top: var(--space-2);
    white-space: nowrap;
    transform: translateX(-50%);
  }

  @container (max-width: 22rem) {
    .pf__specs div {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }

  /* Sloupová: fotka vedle textu, jakmile je místo */
  @container (min-width: 34rem) {
    .pf--tall .pf__layout {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: var(--space-7);
    }

    .pf--tall .pf__media {
      width: 100%;
    }
  }

  /* Kompaktní v široké řadě (přehled modelů): text vlevo, menší fotka vpravo */
  @container (min-width: 46rem) {
    .pf--compact .pf__layout {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      gap: var(--space-7);
    }

    .pf--compact .pf__media {
      grid-column: 2;
      grid-row: 1;
      justify-self: center;
      --pf-media-w: 14rem;
    }

    .pf--compact .pf__body {
      grid-column: 1;
      grid-row: 1;
    }
  }
</style>
