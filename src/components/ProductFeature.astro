---
/**
 * Produktový blok (úvod, přehled modelů). Záměrně nejsou dvě stejné karty:
 * „tall“ = vysoká sloupová (fotka vlevo, velká), „compact“ = kompaktní (fotka vpravo, menší, posunutá).
 */
import { Picture } from 'astro:assets';
import ImageSlot from './ImageSlot.astro';
import { shortSpec, specLabels, type Product } from '../utils/content';
import { formatPrice, typo } from '../utils/format';
import { url } from '../utils/url';

interface Props {
  product: Product;
  variant?: 'tall' | 'compact';
  level?: 2 | 3;
  /** delší popis místo jedné věty (přehled modelů) */
  long?: boolean;
}

const { product, variant = 'tall', level = 3, long = false } = Astro.props;
const { data } = product;
const H = `h${level}` as 'h2' | 'h3';
const href = url(`/reprosoustavy/${product.id}/`);
---

<article class:list={['pf', `pf--${variant}`]} data-reveal>
  <div class="pf__media">
    {data.image ? (
      <Picture
        src={data.image.src}
        alt={data.image.alt}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[400, 700, 1000].filter((w) => w <= data.image!.src.width)}
        sizes={
          variant === 'tall' ? '(min-width: 60rem) 480px, 90vw' : '(min-width: 60rem) 360px, 80vw'
        }
        class="pf__img"
      />
    ) : (
      <ImageSlot ratio="4/5" label={data.imageSlotLabel ?? `Foto: ${data.name} – dodá klient`} />
    )}
  </div>

  <div class="pf__body">
    <span class="eyebrow">{data.type}</span>
    <H class="pf__name">
      <a href={href}>{data.name}</a>
    </H>
    <p class="pf__text">{typo(long ? data.intro : data.tagline)}</p>

    <dl class="pf__specs">
      {data.highlights.map((key) => (
        <div>
          <dt>{specLabels[key]}</dt>
          <dd>{typo(shortSpec(product, key))}</dd>
        </div>
      ))}
    </dl>

    <p class="pf__price">
      <span class="price">{formatPrice(data.price)}</span>
      <span class="muted small"> / pár</span>
    </p>

    <a class="pf__link" href={href}>
      Detail modelu {data.name}
      <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .pf {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-6) var(--grid-gap);
    align-items: end;
  }

  .pf__media,
  .pf__body {
    grid-column: 1 / -1;
  }

  .pf__media :global(.pf__img) {
    width: 100%;
    height: auto;
    filter: var(--product-shadow);
  }

  .pf--tall .pf__media {
    max-width: 26rem;
  }

  .pf--compact .pf__media {
    max-width: 20rem;
  }

  .pf__name {
    margin-top: var(--space-2);
    font-size: var(--fs-xxl);
  }

  .pf__name a {
    color: inherit;
    text-decoration: none;
  }

  .pf__name a:hover {
    color: var(--c-dub-text);
  }

  .pf__text {
    margin-top: var(--space-4);
    font-size: var(--fs-m);
    line-height: 1.5;
    max-width: 36ch;
  }

  .pf__specs {
    display: grid;
    margin-top: var(--space-6);
    border-top: var(--border);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }

  .pf__specs div {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: var(--space-4);
    padding-block: var(--space-2);
    border-bottom: var(--border);
  }

  .pf__specs dt {
    color: var(--c-muted);
  }

  .pf__price {
    margin-top: var(--space-5);
  }

  .pf__price .price {
    font-size: var(--fs-l);
  }

  .pf__link {
    display: inline-flex;
    gap: var(--space-2);
    margin-top: var(--space-4);
    font-weight: 500;
    text-decoration: none;
  }

  .pf__link span {
    transition: transform var(--dur-fast) var(--ease);
  }

  .pf__link:hover span {
    transform: translateX(4px);
  }

  @media (max-width: 30rem) {
    .pf__specs div {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }

  @media (min-width: 48rem) {
    .pf--tall .pf__media {
      grid-column: 1 / span 5;
      max-width: none;
    }

    .pf--tall .pf__body {
      grid-column: 7 / span 6;
      padding-bottom: var(--space-7);
    }

    .pf--compact .pf__body {
      grid-column: 1 / span 6;
      grid-row: 1;
    }

    .pf--compact .pf__media {
      grid-column: 8 / span 4;
      grid-row: 1;
      max-width: none;
      align-self: start;
    }
  }
</style>
