---
import { typo } from '../utils/format';
import { url } from '../utils/url';

interface Props {
  text: string;
  author: string;
  link?: { label: string; href: string };
}

const { text, author, link } = Astro.props;
---

<figure class="quote">
  <blockquote>
    <p>{typo(text)}</p>
  </blockquote>
  <figcaption>
    <span class="quote__author">{author}</span>
    {link && (
      <a class="quote__link" href={url(link.href)}>
        {link.label} <span aria-hidden="true">→</span>
      </a>
    )}
  </figcaption>
</figure>

<style>
  .quote {
    display: grid;
    gap: var(--space-6);
  }

  blockquote p {
    position: relative;
    max-width: 28ch;
    /* Citát se liší od nadpisů: textové písmo v lehčím řezu, větší řádkování */
    font-family: var(--font-text);
    font-size: var(--fs-quote);
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: -0.015em;
    text-wrap: balance;
    text-indent: -0.42em;
  }

  blockquote p::before {
    content: '„';
    color: var(--c-dub);
  }

  blockquote p::after {
    content: '“';
    color: var(--c-dub);
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3) var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
  }

  .quote__author::before {
    content: '';
    display: inline-block;
    width: 2rem;
    margin-right: var(--space-3);
    vertical-align: middle;
    border-top: 1px solid var(--c-grafit);
  }

  .quote__link {
    text-decoration: none;
  }

  .quote__link span {
    display: inline-block;
    transition: transform var(--dur-fast) var(--ease);
  }

  .quote__link:hover span {
    transform: translateX(4px);
  }
</style>
