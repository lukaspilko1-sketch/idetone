---
/**
 * Tlačítko / odkaz ve tvaru tlačítka.
 * Dávka 11.3: dva druhy (plné / obrys), styly `.btn` v base.css. tone dark a wood = tmavý a ořechový podklad.
 */
import type { HTMLAttributes } from 'astro/types';
import { url } from '../utils/url';

type Props = {
  href?: string;
  variant?: 'primary' | 'secondary';
  /** light = na lnu, dark = na antracitu, wood = na dubovém pruhu */
  tone?: 'light' | 'dark' | 'wood';
  arrow?: boolean;
  type?: 'button' | 'submit';
  class?: string;
} & Omit<HTMLAttributes<'a'>, 'href' | 'class'>;

const {
  href,
  variant = 'primary',
  tone = 'light',
  arrow = true,
  type = 'button',
  class: className,
  ...rest
} = Astro.props;

const isExternal = href ? /^(https?:|mailto:|tel:)/.test(href) : false;
const finalHref = href && !isExternal && href.startsWith('/') ? url(href) : href;
const classes = ['btn', `btn--${variant}`, `btn--on-${tone}`, className];
---

{finalHref ? (
  <a href={finalHref} class:list={classes} {...rest}>
    <span>
      <slot />
    </span>
    {arrow && (
      <span class="btn__arrow" aria-hidden="true">
        →
      </span>
    )}
  </a>
) : (
  <button type={type} class:list={classes} {...(rest as HTMLAttributes<'button'>)}>
    <span>
      <slot />
    </span>
    {arrow && (
      <span class="btn__arrow" aria-hidden="true">
        →
      </span>
    )}
  </button>
)}
