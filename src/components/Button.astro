---
/**
 * Tlačítko / odkaz ve tvaru tlačítka.
 * primary = plná Uhel (tmavá), secondary = obrys grafitem. tone="dark" pro použití na tmavé ploše.
 */
import type { HTMLAttributes } from 'astro/types';
import { url } from '../utils/url';

type Props = {
  href?: string;
  variant?: 'primary' | 'secondary';
  tone?: 'light' | 'dark';
  arrow?: boolean;
  type?: 'button' | 'submit';
  class?: string;
} & Omit<HTMLAttributes<'a'>, 'href' | 'class'>;

const {
  href,
  variant = 'primary',
  tone = 'light',
  arrow = true,
  type = 'button',
  class: className,
  ...rest
} = Astro.props;

const isExternal = href ? /^(https?:|mailto:|tel:)/.test(href) : false;
const finalHref = href && !isExternal && href.startsWith('/') ? url(href) : href;
const classes = ['btn', `btn--${variant}`, `btn--on-${tone}`, className];
---

{finalHref ? (
  <a href={finalHref} class:list={classes} {...rest}>
    <span>
      <slot />
    </span>
    {arrow && (
      <span class="btn__arrow" aria-hidden="true">
        →
      </span>
    )}
  </a>
) : (
  <button type={type} class:list={classes} {...(rest as HTMLAttributes<'button'>)}>
    <span>
      <slot />
    </span>
    {arrow && (
      <span class="btn__arrow" aria-hidden="true">
        →
      </span>
    )}
  </button>
)}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    min-height: 2.875rem;
    padding: var(--space-3) var(--space-5);
    border: 1px solid transparent;
    border-radius: var(--radius-btn);
    font-family: var(--font-text);
    font-size: var(--fs-s);
    font-weight: 500;
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }

  .btn__arrow {
    font-family: var(--font-mono);
    transition: transform var(--dur-fast) var(--ease);
  }

  .btn:hover .btn__arrow,
  .btn:focus-visible .btn__arrow {
    transform: translateX(4px);
  }

  /* Na světlé ploše */
  .btn--primary.btn--on-light {
    background: var(--c-uhel);
    color: var(--c-on-dark);
  }

  .btn--primary.btn--on-light:hover {
    background: var(--c-uhel-hover);
    color: var(--c-on-dark);
  }

  .btn--secondary.btn--on-light {
    border-color: var(--c-grafit);
    color: var(--c-grafit);
  }

  .btn--secondary.btn--on-light:hover {
    background: var(--c-papir);
    color: var(--c-grafit);
  }

  /* Na tmavé ploše */
  .btn--primary.btn--on-dark {
    background: var(--c-on-dark);
    color: var(--c-uhel);
  }

  .btn--primary.btn--on-dark:hover {
    background: var(--c-papir);
    color: var(--c-uhel);
  }

  .btn--secondary.btn--on-dark {
    border-color: var(--c-on-dark);
    color: var(--c-on-dark);
  }

  .btn--secondary.btn--on-dark:hover {
    background: var(--c-uhel-hover);
    color: var(--c-on-dark);
  }
</style>
