---
import Logo from './Logo.astro';
import { site, nav, legalNav } from '../config/site';
import { cs } from '../i18n/cs';
import { url } from '../utils/url';
import { getSettings } from '../utils/content';

const settings = await getSettings();

const year = new Date().getFullYear();
const pages = nav.flatMap((item) => [item, ...(item.children ?? [])]);
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <a href={url('/')} aria-label={cs.nav.home} class="footer__logo">
          <Logo variant="light" height="1.125rem" />
        </a>
        <p class="footer__claim">{site.claim}</p>
      </div>

      <div class="footer__col">
        <h2 class="eyebrow footer__title">{cs.footer.contact}</h2>
        <p>
          {settings.contact.person}
          <br />
          <a href={`mailto:${settings.contact.email}`}>{settings.contact.email}</a>
          {settings.contact.phone && (
            <>
              <br />
              <a href={`tel:${settings.contact.phone.replace(/\s/g, '')}`}>
                {settings.contact.phone}
              </a>
            </>
          )}
        </p>
      </div>

      <div class="footer__col">
        <h2 class="eyebrow footer__title">{cs.footer.studio}</h2>
        <address>
          {settings.studio.street}
          <br />
          {settings.studio.city}
        </address>
      </div>

      <nav class="footer__col" id="navigace-paticka" aria-label={cs.footer.nav}>
        <h2 class="eyebrow footer__title">{cs.footer.nav}</h2>
        <ul role="list" class="footer__links">
          {pages.map((item) => (
            <li>
              <a href={url(item.href)}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="footer__bottom">
      <p class="mono">© {year} ideTone</p>
      <ul role="list" class="footer__meta" aria-label={cs.footer.legal}>
        {legalNav.map((item) => (
          <li>
            <a href={url(item.href)}>{item.label}</a>
          </li>
        ))}
        {settings.social.facebook && (
          <li>
            <a href={settings.social.facebook} rel="noopener">
              {cs.footer.facebook}
            </a>
          </li>
        )}
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--space-9) var(--space-6);
    background: var(--c-uhel);
    border-top: 1px solid var(--c-line-dark); /* oddělí patičku od tmavého pruhu nad ní */
    color: var(--c-on-dark);
  }

  .footer a {
    color: var(--c-on-dark);
    text-decoration-color: var(--c-line-dark);
  }

  .footer a:hover {
    color: var(--c-dub-light);
    text-decoration-color: currentColor;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-7) var(--grid-gap);
  }

  .footer__brand {
    grid-column: 1 / -1;
  }

  .footer__col {
    grid-column: span 6;
  }

  .footer__logo {
    display: inline-flex;
    padding-block: var(--space-2);
  }

  .footer__claim {
    margin-top: var(--space-4);
    font-family: var(--font-heading);
    font-size: var(--fs-l);
    line-height: 1.25;
    max-width: 16ch;
  }

  .footer__title {
    margin-bottom: var(--space-3);
    color: var(--c-on-dark-muted);
  }

  .footer address {
    font-style: normal;
  }

  .footer__links {
    display: grid;
    gap: var(--space-1);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    margin-top: var(--space-9);
    padding-top: var(--space-5);
    border-top: 1px solid var(--c-line-dark);
    font-size: var(--fs-xs);
    color: var(--c-on-dark-muted);
  }

  .footer__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }

  .footer__meta a {
    color: var(--c-on-dark-muted);
  }

  @media (max-width: 30rem) {
    .footer__col {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 60rem) {
    .footer__brand {
      grid-column: span 5;
    }

    .footer__col {
      grid-column: span 2;
    }

    .footer__col:last-child {
      grid-column: span 3;
    }
  }
</style>
