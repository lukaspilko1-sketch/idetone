---
import Logo from './Logo.astro';
import GlassBackdrop from './GlassBackdrop.astro';
import { site, nav, legalNav } from '../config/site';
import { cs } from '../i18n/cs';
import { url } from '../utils/url';
import { getSettings } from '../utils/content';

const settings = await getSettings();

const year = new Date().getFullYear();
const pages = nav.flatMap((item) => [item, ...(item.children ?? [])]);
---

<footer class="footer">
  <GlassBackdrop position="20% 80%" />
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <a href={url('/')} aria-label={cs.nav.home} class="footer__logo">
          <Logo variant="light" height="1.125rem" />
        </a>
        <p class="footer__claim">{site.claim}</p>
      </div>

      <div class="footer__col">
        <h2 class="eyebrow footer__title">{cs.footer.contact}</h2>
        <p>
          {settings.contact.person}
          <br />
          <a href={`mailto:${settings.contact.email}`}>{settings.contact.email}</a>
          {settings.contact.phone && (
            <>
              <br />
              <a href={`tel:${settings.contact.phone.replace(/\s/g, '')}`}>
                {settings.contact.phone}
              </a>
            </>
          )}
        </p>
      </div>

      <div class="footer__col">
        <h2 class="eyebrow footer__title">{cs.footer.studio}</h2>
        <address>
          {settings.studio.street}
          <br />
          {settings.studio.city}
        </address>
        {settings.studio.mapyCz && (
          <p class="footer__map">
            <a href={settings.studio.mapyCz} rel="noopener">
              {cs.footer.map}
            </a>
          </p>
        )}
      </div>

      <nav class="footer__col" id="navigace-paticka" aria-label={cs.footer.nav}>
        <h2 class="eyebrow footer__title">{cs.footer.nav}</h2>
        <ul role="list" class="footer__links">
          {pages.map((item) => (
            <li>
              <a href={url(item.href)}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="footer__bottom">
      <p class="mono">© {year} ideTone</p>
      <ul role="list" class="footer__meta" aria-label={cs.footer.legal}>
        {legalNav.map((item) => (
          <li>
            <a href={url(item.href)}>{item.label}</a>
          </li>
        ))}
        {settings.social.facebook && (
          <li>
            <a href={settings.social.facebook} rel="noopener">
              {cs.footer.facebook}
            </a>
          </li>
        )}
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    isolation: isolate;
    padding-block: var(--space-9) var(--space-6);
    background: var(--c-uhel);
    color: var(--c-on-dark);
  }

  .footer a {
    color: var(--c-on-dark);
    text-decoration-color: var(--c-line-dark);
  }

  .footer a:hover {
    color: var(--c-dub-light);
    text-decoration-color: currentColor;
  }

  /* Dávka 9.3: mobil 1 sloupec, tablet 2 × 2, desktop 4 stejné sloupce, obsah nahoře */
  .footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6) var(--grid-gap);
    align-items: start;
  }

  .footer__logo {
    display: inline-flex;
    /* výška řádku jako štítek nadpisu ostatních sloupců → logo na stejné lince */
    min-height: calc(var(--fs-label) * 1.5);
    align-items: center;
  }

  .footer__claim {
    margin-top: var(--space-3);
    font-family: var(--font-heading);
    font-size: var(--fs-m);
    line-height: 1.3;
    max-width: 16ch;
  }

  .footer__title {
    margin-bottom: var(--space-3);
    color: var(--c-on-dark-muted);
  }

  .footer address {
    font-style: normal;
  }

  .footer__map {
    margin-top: var(--space-2);
  }

  /* 8 odkazů ve dvou sloupcích po 4 (řazení po sloupcích), aby sloupec nebyl vyšší než ostatní */
  .footer__links {
    display: grid;
    grid-template-rows: repeat(4, auto);
    grid-auto-flow: column;
    justify-content: start;
    gap: var(--space-1) var(--space-4);
  }

  .footer__links a {
    white-space: nowrap;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--c-line-dark);
    font-size: var(--fs-legal);
    color: var(--c-on-dark-muted);
  }

  .footer__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
  }

  .footer__meta a {
    color: var(--c-on-dark-muted);
  }

  @media (min-width: 40rem) {
    .footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-7) var(--grid-gap);
    }
  }

  @media (min-width: 64rem) {
    .footer__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .footer__bottom {
      margin-top: var(--space-9);
    }
  }

  /* 4 sloupce na užším desktopu: dva sloupce odkazů by se nevešly, odkazy pod sebou */
  @media (min-width: 64rem) and (max-width: 79.99rem) {
    .footer__links {
      grid-template-rows: none;
      grid-auto-flow: row;
    }
  }

  @media (max-width: 47.99rem) {
    .footer {
      padding-block: var(--space-7) var(--space-5);
    }

    .footer__grid {
      gap: var(--space-5);
    }

    .footer__bottom {
      margin-top: var(--space-6);
    }

    /* 9b.1: Kontakt a Poslechové studio vedle sebe (úzký sloupec, dlouhý e-mail se zalomí) */
    .footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer__brand,
    .footer__grid > nav {
      grid-column: 1 / -1;
    }

    .footer__col {
      overflow-wrap: anywhere;
    }
  }
</style>
