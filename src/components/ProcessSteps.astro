---
/**
 * Číslované kroky s fotkou (Proces vývoje na úvodu a na Technologiích). Číslování jen u skutečného postupu.
 */
import type { ImageMetadata } from 'astro';
import Photo from './Photo.astro';
import { typo } from '../utils/format';

interface Step {
  title: string;
  text: string;
  image?: { src: ImageMetadata; alt: string; placeholder?: boolean };
}

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;
---

<ol role="list" class="process">
  {steps.map((step, i) => (
    <li class="process__step">
      {step.image && (
        <Photo
          src={step.image.src}
          alt={step.image.alt}
          placeholder={step.image.placeholder}
          ratio="3/2"
          sizes="(min-width: 64rem) 380px, (min-width: 48rem) 33vw, 100vw"
        />
      )}
      <div class="process__text" data-reveal>
        <span class="process__num" aria-hidden="true">
          {i + 1}
        </span>
        <h3>{typo(step.title)}</h3>
        <p>{typo(step.text)}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .process {
    display: grid;
    gap: var(--space-7) var(--grid-gap);
  }

  .process__step {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    max-width: none;
  }

  /* Linka nad krokem v namíchané barvě dub/linka (dávka 4.3) */
  .process__text {
    padding-top: var(--space-4);
    border-top: 2px solid var(--c-step-line);
  }

  /* Velké dubové číslo kroku */
  .process__num {
    display: block;
    margin-bottom: var(--space-3);
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 500;
    line-height: 1;
    color: var(--c-dub);
  }

  h3 {
    font-size: var(--fs-m);
  }

  p {
    margin-top: var(--space-2);
  }

  @media (min-width: 48rem) {
    .process {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
