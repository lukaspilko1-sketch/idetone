---
/**
 * Kroky s fotkou (Proces vývoje na úvodu a na Technologiích) – bez číslování a bez oddělovacích čar.
 */
import type { ImageMetadata } from 'astro';
import Photo from './Photo.astro';
import { typo } from '../utils/format';

interface Step {
  title: string;
  text: string;
  image?: { src: ImageMetadata; alt: string; placeholder?: boolean };
}

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;
---

<ol role="list" class="process">
  {steps.map((step) => (
    <li class="process__step">
      {step.image && (
        <Photo
          src={step.image.src}
          alt={step.image.alt}
          placeholder={step.image.placeholder}
          ratio="3/2"
          sizes="(min-width: 64rem) 380px, (min-width: 48rem) 33vw, 100vw"
        />
      )}
      <div class="process__text" data-reveal>
        <h3>{typo(step.title)}</h3>
        <p>{typo(step.text)}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .process {
    display: grid;
    gap: var(--block-space) var(--grid-gap);
  }

  .process__step {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    max-width: none;
  }

  .process__text {
    padding-top: var(--space-1);
  }

  h3 {
    font-size: var(--fs-m);
  }

  p {
    margin-top: var(--space-2);
  }

  /* Dávka 9.7: na mobilu nižší fotky kroků (méně rolování, text beze změny) */
  @media (max-width: 47.99rem) {
    .process__step :global(.photo--ratio) {
      aspect-ratio: 16 / 9;
    }
  }

  @media (min-width: 48rem) {
    .process {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
