---
/**
 * Obsahová fotka (ilustrační i skutečná): ořez na poměr stran, AVIF/WebP, odhalení při scrollu.
 * Dočasné AI ilustrace (placeholder: true) se barevně sjednotí s paletou (--photo-ai-filter).
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  placeholder?: boolean;
  ratio?: '4/5' | '16/9' | '1/1' | '3/2';
  sizes?: string;
  loading?: 'lazy' | 'eager';
  /** výřez (object-position) */
  position?: string;
  reveal?: boolean;
  class?: string;
}

const {
  src,
  alt,
  placeholder = false,
  ratio,
  sizes = '(min-width: 75rem) 600px, 100vw',
  loading = 'lazy',
  position = '50% 50%',
  reveal = true,
  class: className,
} = Astro.props;

// Ilustrace mají menší rozlišení – nezvětšovat nad originál
const widths = [480, 800, 1200, 1600].filter((w) => w <= src.width);
---

<figure
  class:list={['photo', { 'photo--ai': placeholder, 'photo--ratio': ratio }, className]}
  style={`${ratio ? `--ratio: ${ratio};` : ''} --pos: ${position}`}
  data-reveal-img={reveal ? '' : undefined}
>
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    widths={widths.length ? widths : [src.width]}
    sizes={sizes}
    loading={loading}
    class="photo__img"
  />
</figure>

<style>
  .photo {
    overflow: hidden;
    border-radius: var(--radius);
  }

  .photo :global(.photo__img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .photo--ratio {
    aspect-ratio: var(--ratio);
  }

  .photo--ratio :global(.photo__img) {
    height: 100%;
    object-fit: cover;
    object-position: var(--pos);
  }

  .photo--ai :global(.photo__img) {
    filter: var(--photo-ai-filter);
  }
</style>
