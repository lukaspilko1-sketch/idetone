---
/** Úvod podstránky: štítek, H1, perex. */
import { typo } from '../utils/format';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<header class="page-header container">
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <h1>{typo(title)}</h1>
  {lead && <p class="lead">{typo(lead)}</p>}
  <slot />
</header>

<style>
  .page-header {
    padding-top: clamp(var(--space-7), 6vw, var(--space-9));
    padding-bottom: clamp(var(--space-7), 5vw, var(--space-8));
  }

  h1 {
    margin-top: var(--space-3);
    max-width: 18ch;
  }

  .lead {
    margin-top: var(--space-5);
    max-width: 50ch;
    color: var(--c-muted);
  }
</style>
