---
/**
 * Galerie produktu: hlavní fotka + miniatury, šipky, swipe, lightbox.
 * Bez JS: první fotka a miniatury jako odkazy na velké verze.
 * Když fotky chybí, zobrazí se ImageSlot(y).
 */
import type { ImageMetadata } from 'astro';
import { Picture, getImage } from 'astro:assets';
import ImageSlot from './ImageSlot.astro';

interface Photo {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  name: string;
  images: Photo[];
  slots?: { label: string; ratio: '4/5' | '16/9' | '1/1' | '3/2' }[];
  slotLabel?: string;
}

const { name, images, slots = [], slotLabel } = Astro.props;

const items = await Promise.all(
  images.map(async (img) => {
    const full = await getImage({
      src: img.src,
      width: Math.min(1600, img.src.width),
      format: 'webp',
    });
    return { ...img, full: full.src };
  }),
);
---

{items.length > 0 ? (
  <div class="gallery" data-gallery>
    <div class="gallery__stage" data-stage>
      {items.map((img, i) => (
        <a
          href={img.full}
          class="gallery__slide"
          data-slide
          data-full={img.full}
          hidden={i !== 0}
          aria-label={`Zvětšit fotku: ${img.alt}`}
        >
          <Picture
            src={img.src}
            alt={img.alt}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[480, 800, 1200].filter((w) => w <= img.src.width)}
            sizes="(min-width: 60rem) 640px, 100vw"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
          />
        </a>
      ))}
      {items.length > 1 && (
        <div class="gallery__arrows">
          <button type="button" class="gallery__arrow" data-prev aria-label="Předchozí fotka">
            ←
          </button>
          <span class="gallery__count mono" aria-live="polite" data-count>
            1 / {items.length}
          </span>
          <button type="button" class="gallery__arrow" data-next aria-label="Další fotka">
            →
          </button>
        </div>
      )}
    </div>

    {items.length > 1 && (
      <ul role="list" class="gallery__thumbs" aria-label={`Fotky ${name}`}>
        {items.map((img, i) => (
          <li>
            <a
              href={img.full}
              class="gallery__thumb"
              data-thumb={i}
              aria-current={i === 0 ? 'true' : undefined}
              aria-label={`Fotka ${i + 1}: ${img.alt}`}
            >
              <Picture
                src={img.src}
                alt=""
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                widths={[120, 240]}
                sizes="120px"
              />
            </a>
          </li>
        ))}
      </ul>
    )}

    <dialog class="lightbox" data-lightbox aria-label={`Fotky ${name}`}>
      <img class="lightbox__img" alt="" data-lightbox-img />
      <div class="lightbox__bar">
        <button type="button" class="lightbox__btn" data-lb-prev aria-label="Předchozí fotka">
          ←
        </button>
        <button type="button" class="lightbox__btn" data-lb-next aria-label="Další fotka">
          →
        </button>
        <button type="button" class="lightbox__btn lightbox__close" data-lb-close>
          Zavřít
        </button>
      </div>
    </dialog>
  </div>
) : (
  <div class="gallery gallery--slots">
    <ImageSlot ratio="4/5" label={slotLabel ?? `Foto: ${name} – dodá klient`} />
    {slots.length > 0 && (
      <div class="gallery__slotgrid">
        {slots.map((s) => (
          <ImageSlot ratio={s.ratio} label={s.label} />
        ))}
      </div>
    )}
  </div>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const slides = [...gallery.querySelectorAll<HTMLAnchorElement>('[data-slide]')];
    const thumbs = [...gallery.querySelectorAll<HTMLAnchorElement>('[data-thumb]')];
    const count = gallery.querySelector<HTMLElement>('[data-count]');
    const stage = gallery.querySelector<HTMLElement>('[data-stage]');
    const dialog = gallery.querySelector<HTMLDialogElement>('[data-lightbox]');
    const lbImg = gallery.querySelector<HTMLImageElement>('[data-lightbox-img]');
    let current = 0;

    const show = (index: number) => {
      current = (index + slides.length) % slides.length;
      slides.forEach((s, i) => (s.hidden = i !== current));
      thumbs.forEach((t, i) =>
        i === current ? t.setAttribute('aria-current', 'true') : t.removeAttribute('aria-current'),
      );
      if (count) count.textContent = `${current + 1} / ${slides.length}`;
      if (dialog?.open && lbImg) setLightbox();
    };

    const setLightbox = () => {
      if (!lbImg) return;
      const slide = slides[current];
      lbImg.src = slide.dataset.full ?? '';
      lbImg.alt = slide.querySelector('img')?.alt ?? '';
    };

    gallery.querySelector('[data-prev]')?.addEventListener('click', () => show(current - 1));
    gallery.querySelector('[data-next]')?.addEventListener('click', () => show(current + 1));
    thumbs.forEach((t, i) =>
      t.addEventListener('click', (e) => {
        e.preventDefault();
        show(i);
      }),
    );

    // Swipe na hlavní fotce
    let startX = 0;
    stage?.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), {
      passive: true,
    });
    stage?.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 40) show(current + (dx < 0 ? 1 : -1));
    });

    // Lightbox
    slides.forEach((s) =>
      s.addEventListener('click', (e) => {
        if (!dialog) return;
        e.preventDefault();
        setLightbox();
        dialog.showModal();
      }),
    );
    dialog?.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(current - 1));
    dialog?.querySelector('[data-lb-next]')?.addEventListener('click', () => show(current + 1));
    dialog?.querySelector('[data-lb-close]')?.addEventListener('click', () => dialog.close());
    dialog?.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

    // Šipky na klávesnici (v lightboxu i na galerii)
    gallery.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
  });
</script>

<style>
  .gallery__stage {
    position: relative;
  }

  .gallery__slide {
    display: block;
    aspect-ratio: 4 / 5;
    cursor: zoom-in;
  }

  .gallery__slide[hidden] {
    display: none;
  }

  .gallery__slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: var(--product-shadow);
  }

  .gallery__arrows {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-3);
  }

  .gallery__arrow {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    background: none;
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease);
  }

  .gallery__arrow:hover {
    border-color: var(--c-grafit);
  }

  .gallery__count {
    font-size: var(--fs-xs);
    color: var(--c-muted);
  }

  .gallery__thumbs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(4rem, 1fr));
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .gallery__thumb {
    display: block;
    aspect-ratio: 1;
    padding: var(--space-1);
    border: 1px solid transparent;
    border-radius: var(--radius);
    transition: border-color var(--dur-fast) var(--ease);
  }

  .gallery__thumb:hover,
  .gallery__thumb[aria-current='true'] {
    border-color: var(--c-dub);
  }

  .gallery__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .gallery--slots {
    display: grid;
    gap: var(--space-3);
  }

  .gallery__slotgrid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }

  /* Lightbox */
  .lightbox {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: var(--space-5);
    background: var(--glass-overlay);
    border: 0;
    color: var(--c-on-dark);
  }

  .lightbox[open] {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: var(--space-4);
  }

  .lightbox::backdrop {
    background: transparent;
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
  }

  .lightbox__img {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
  }

  .lightbox__bar {
    display: flex;
    justify-content: center;
    gap: var(--space-3);
  }

  .lightbox__btn {
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0 var(--space-4);
    background: none;
    border: 1px solid var(--c-line-dark);
    border-radius: var(--radius);
    color: var(--c-on-dark);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    cursor: pointer;
  }

  .lightbox__btn:hover {
    border-color: var(--c-on-dark);
  }
</style>
